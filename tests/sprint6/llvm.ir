; ModuleID = 'e10_generic_iter.ms'
source_filename = "e10_generic_iter.ms"

%Range = type { i32, i32 }

define { i32, [4 x i64] } @next(ptr %"0") {
entry0:
  %"1" = alloca ptr, align 8
  store ptr %"0", ptr %"1", align 8
  %"2" = load ptr, ptr %"1", align 8
  %"3" = load i32, ptr %"2", align 4
  %"4" = load ptr, ptr %"1", align 8
  %"5" = load i32, ptr %"4", align 4
  %"6" = icmp slt i32 %"3", %"5"
  br i1 %"6", label %then1, label %merge2

then1:                                            ; preds = %entry0
  %"7" = alloca i32, align 4
  %"8" = load ptr, ptr %"1", align 8
  %"9" = load i32, ptr %"8", align 4
  store i32 %"9", ptr %"7", align 4
  %"10" = load ptr, ptr %"1", align 8
  %"11" = load i32, ptr %"10", align 4
  %"12" = add i32 %"11", 1
  %"13" = load ptr, ptr %"1", align 8
  store i32 %"12", ptr %"13", align 4
  %"14" = load i32, ptr %"7", align 4
  %0 = alloca { i32, [4 x i64] }, align 8
  %1 = getelementptr inbounds { i32, [4 x i64] }, ptr %0, i32 0, i32 0
  store i32 0, ptr %1, align 4
  %2 = getelementptr inbounds { i32, [4 x i64] }, ptr %0, i32 0, i32 1
  %3 = getelementptr inbounds { i32 }, ptr %2, i32 0, i32 0
  store i32 %"14", ptr %3, align 4
  %"15" = load { i32, [4 x i64] }, ptr %0, align 4
  ret { i32, [4 x i64] } %"15"

merge2:                                           ; preds = %entry0
  %4 = alloca { i32, [4 x i64] }, align 8
  %5 = getelementptr inbounds { i32, [4 x i64] }, ptr %4, i32 0, i32 0
  store i32 1, ptr %5, align 4
  %"16" = load { i32, [4 x i64] }, ptr %4, align 4
  ret { i32, [4 x i64] } %"16"
}

define i32 @main() {
entry0:
  %"0" = alloca %Range, align 8
  %"1" = alloca %Range, align 8
  store i32 1, ptr %"1", align 4
  store i32 3, ptr %"1", align 4
  %"2" = load %Range, ptr %"1", align 4
  store %Range %"2", ptr %"0", align 4
  %"3" = alloca i32, align 4
  store i32 1, ptr %"0", align 4
  store ptr %"0", ptr %"3", align 8
  %"4" = alloca i32, align 4
  store i32 3, ptr %"0", align 4
  store ptr %"0", ptr %"4", align 8
  %"5" = alloca { i32, [4 x i64] }, align 8
  %"7" = call { i32, [4 x i64] } @get_next_Range(ptr %"0")
  store { i32, [4 x i64] } %"7", ptr %"5", align 4
  %"9" = load { i32, [4 x i64] }, ptr %"5", align 4
  %"10" = extractvalue { i32, [4 x i64] } %"9", 0
  switch i32 %"10", label %match_unreachable4 [
    i32 0, label %match_arm2
    i32 1, label %match_arm3
  ]

match_unreachable4:                               ; preds = %entry0
  unreachable

match_arm2:                                       ; preds = %entry0
  %0 = alloca { i32, [4 x i64] }, align 8
  store { i32, [4 x i64] } %"9", ptr %0, align 4
  %1 = getelementptr inbounds { i32, [4 x i64] }, ptr %0, i32 0, i32 1
  %2 = getelementptr inbounds { i32 }, ptr %1, i32 0, i32 0
  %"12" = load i32, ptr %2, align 4
  %"13" = alloca i32, align 4
  store i32 %"12", ptr %"13", align 4
  %"14" = load i32, ptr %"13", align 4
  %"15" = icmp eq i32 %"14", 1
  br i1 %"15", label %then5, label %merge6

then5:                                            ; preds = %match_arm2
  ret i32 0

merge6:                                           ; preds = %match_arm2
  ret i32 1

match_arm3:                                       ; preds = %entry0
  ret i32 1

match_end1:                                       ; No predecessors!
  ret i32 1
}

define { i32, [4 x i64] } @get_next_Range(ptr %"0") {
entry0:
  %"1" = alloca ptr, align 8
  store ptr %"0", ptr %"1", align 8
  %"2" = load ptr, ptr %"1", align 8
  %"3" = call { i32, [4 x i64] } @next(ptr %"2")
  ret { i32, [4 x i64] } %"3"
}

define linkonce i1 @mellis_coro_is_done(ptr %0) {
entry:
  %1 = call i1 @llvm.coro.done(ptr %0)
  ret i1 %1
}

; Function Attrs: nounwind memory(argmem: readwrite)
declare i1 @llvm.coro.done(ptr nocapture readonly) #0

define linkonce void @mellis_coro_resume(ptr %0) {
entry:
  call void @llvm.coro.resume(ptr %0)
  ret void
}

declare void @llvm.coro.resume(ptr)

attributes #0 = { nounwind memory(argmem: readwrite) }
