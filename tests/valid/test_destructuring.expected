%Point = type { i32, i32 }

define void @test_struct_destructuring() {
entry0:
  %"0" = alloca %Point, align 8
  %"1" = alloca %Point, align 8
  %"4" = alloca %Point, align 8
  %"5" = alloca i32, align 4
  %"6" = alloca i32, align 4
  %"7" = alloca i32, align 4
