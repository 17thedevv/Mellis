  %"53" = load i32, ptr %fld2, align 4
  store i32 %"53", ptr %"6", align 4
  %fld4 = getelementptr inbounds %Point, ptr %"4", i32 0, i32 1
  %"75" = load i32, ptr %fld4, align 4
  store i32 %"75", ptr %"8", align 4
  ret void
}

define void @test_tuple_destructuring() {
entry0:
  %"0" = alloca { i32, i32 }, align 8
