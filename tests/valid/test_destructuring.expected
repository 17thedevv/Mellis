  %"4" = alloca { i32, i32 }, align 8
  %"5" = alloca i32, align 4
  %"6" = alloca i32, align 4
  %"7" = alloca i32, align 4
  %"8" = alloca i32, align 4
  %fld = getelementptr inbounds { i32, i32 }, ptr %"1", i32 0, i32 0
  store i32 10, ptr %fld, align 4
  %fld1 = getelementptr inbounds { i32, i32 }, ptr %"1", i32 0, i32 1
  store i32 20, ptr %fld1, align 4
  %"2" = load { i32, i32 }, ptr %"1", align 4
  store { i32, i32 } %"2", ptr %"0", align 4
  %"3" = load { i32, i32 }, ptr %"0", align 4
  store { i32, i32 } %"3", ptr %"4", align 4
