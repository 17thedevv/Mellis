  store i32 %"52", ptr %"6", align 4
  %tidx3 = getelementptr inbounds { i32, i32 }, ptr %"4", i32 0, i32 1
  %"74" = load i32, ptr %tidx3, align 4
  store i32 %"74", ptr %"8", align 4
  ret void
}

define void @main() {
entry0:
