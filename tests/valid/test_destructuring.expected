  %fld1 = getelementptr inbounds %Point, ptr %"1", i32 0, i32 1
  store i32 20, ptr %fld1, align 4
  %"2" = load %Point, ptr %"1", align 4
  store %Point %"2", ptr %"0", align 4
  %"3" = load %Point, ptr %"0", align 4
  store %Point %"3", ptr %"4", align 4
