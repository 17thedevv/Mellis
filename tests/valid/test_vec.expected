[MLibLoader] replacedSource: impl<T> core::ops::drop::Drop for Vec<T> {

    fn drop(self: &rw Self) {

        if self.cap > (0 as uint_64) {

            dec size = self.cap * sizeof(T);

            dec align = alignof(T);

            __mellis_dealloc(self.ptr as *rw uint_8, size, align);

            self.cap = 0 as uint_64;

            self.len = 0 as uint_64;

            self.ptr = 0 as *rw T;

        }

    }

}
