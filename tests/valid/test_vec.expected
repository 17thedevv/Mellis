[MLibLoader] replacedSource: impl<T> Vec<T> {



    export fn push(self: &rw Self, item: T) {

        if self.len == self.cap {

            self.grow();

        }

        dec offset_ptr = (self.ptr as uint_64 + (self.len * sizeof(T))) as *rw T;

        unsafe {

            *offset_ptr = item;

        }

        self.len = self.len + (1 as uint_64);

    }



    export fn pop(self: &rw Self) -> core::option::Option<T> {

        if self.len == (0 as uint_64) {

            return core::option::Option::None;

        }

        self.len = self.len - (1 as uint_64);

        dec offset_ptr = (self.ptr as uint_64 + (self.len * sizeof(T))) as *rw T;

        unsafe {

            return core::option::Option::Some(*offset_ptr);

        }

    }



    export fn len(self: &Self) -> uint_64 {

        return self.len;

    }



    export fn capacity(self: &Self) -> uint_64 {

        return self.cap;

    }



    export fn grow(self: &rw Self) {

        dec new_cap: uint_64 = 0 as uint_64;

        if self.cap == (0 as uint_64) {

            new_cap = 4 as uint_64;

        } else {

            new_cap = self.cap * (2 as uint_64);

        }

        

        dec new_size = new_cap * sizeof(T);

        dec align = alignof(T);

        dec new_ptr = __mellis_alloc(new_size, align) as *rw T;



        if self.cap > (0 as uint_64) {

            dec i: uint_64 = 0 as uint_64;

            while i < self.len {

                dec src = (self.ptr as uint_64 + (i * sizeof(T))) as *rw T;

                dec dst = (new_ptr as uint_64 + (i * sizeof(T))) as *rw T;

                unsafe {

                    *dst = *src;

                }

                i = i + (1 as uint_64);

            }

            dec old_size = self.cap * sizeof(T);

            __mellis_dealloc(self.ptr as *rw uint_8, old_size, align);

        }



        self.ptr = new_ptr;

        self.cap = new_cap;

    }

}
