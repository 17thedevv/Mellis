[MLibLoader] replacedSource: export fn vec_with_capacity<T>(capacity: uint_64) -> Vec<T> {

    if capacity == (0 as uint_64) {

        return vec_new@<T>();

    }

    dec size = capacity * sizeof(T);

    dec align = alignof(T);

    dec ptr = __mellis_alloc(size, align) as *rw T;

    return Vec {

        ptr: ptr,

        len: 0 as uint_64,

        cap: capacity,

    };

}
