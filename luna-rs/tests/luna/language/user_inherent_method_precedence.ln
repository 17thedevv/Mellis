trait Value {
    fn value(self: &Self) -> i32;
}

struct Counter {
    current: i32,
};

impl Counter {
    fn value(self: &Self) -> i32 {
        return self.current;
    }
}

impl Value for Counter {
    fn value(self: &Self) -> i32 {
        return self.value();
    }
}

fn main() -> i32 {
    dec counter = Counter { current: 7 };
    if counter.value() != 7 { return 1; }
    return 0;
}
