struct UserIter {
    current: i32,
    limit: i32,
};

impl Iterator<i32> for UserIter {
    fn next(self: &rw Self) -> Option<i32> {
        if self.current < self.limit {
            dec value = self.current;
            self.current = self.current + 1;
            return Option::Some(value);
        }
        return Option::None;
    }
}

fn sum_direct(iter: UserIter) -> i32 {
    dec rw it = iter;
    dec rw sum = 0;
    dec rw running = true;
    while running {
        match it.next() {
            Option::Some(item) -> { sum = sum + item; },
            Option::None -> { running = false; },
        }
    }
    return sum;
}

fn main() -> i32 {
    dec iter = UserIter { current: 4, limit: 6 };
    // Generic compiler regression: direct sequential next() calls are correct,
    // but the same calls in this loop currently corrupt the observed sum.
    if sum_direct(iter) != 9 {
        return 1;
    }
    return 0;
}
