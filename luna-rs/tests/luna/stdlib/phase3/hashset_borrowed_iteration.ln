import <hashset>;

fn main() -> i32 {
    dec rw set = hashset_new<u64>();
    set.insert(1 as u64);
    set.insert(2 as u64);
    set.insert(3 as u64);
    dec rw count = 0 as u64;
    dec rw sum = 0 as u64;
    dec rw iter = set.iter();
    dec rw running = true;
    while running {
        match iter.next() {
            Option::Some(value) -> {
                count = count + (1 as u64);
                sum = sum + *value;
            },
            Option::None -> { running = false; },
        }
    }
    if count != (3 as u64) || sum != (6 as u64) {
        return 1;
    }
    return 0;
}
