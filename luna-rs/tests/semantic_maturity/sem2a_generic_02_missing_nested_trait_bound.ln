// SEM2A-GENERIC-02: a missing nested generic trait bound rejects explicitly.
struct Wrapper<T> {
    value: T,
};

trait Mapper<A, B> {
    fn map(self: &Self, input: A) -> B;
}

struct NotAMapper {};

fn apply<M: Mapper<Wrapper<i32>, Wrapper<bool>>>(
    mapper: &M,
    input: Wrapper<i32>
) -> Wrapper<bool> {
    return mapper.map(input);
}

fn main() {
    dec mapper = NotAMapper {};
    dec result = apply<NotAMapper>(&mapper, Wrapper<i32> { value: 42 });
}
