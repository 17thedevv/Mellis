import <__lang_option>;
import <__lang_iterator>;

// =========================================================================
// Terminal Consumers: fold, count, for_each, any, all, find
// =========================================================================

export fn iter_fold<FoldIter: Iterator<FoldItem>, FoldItem, B>(iter: FoldIter, init: B, f: fn(B, FoldItem) -> B) -> B {
    dec rw it = iter;
    dec rw acc = init;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec f_ptr = f;
                acc = f_ptr(acc, x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return acc;
}

export fn iter_count<CountIter: Iterator<CountItem>, CountItem>(iter: CountIter) -> u64 {
    dec rw it = iter;
    dec rw count: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(_) -> {
                count = count + (1 as u64);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return count;
}

export fn iter_for_each<EachIter: Iterator<EachItem>, EachItem>(iter: EachIter, f: fn(EachItem)) {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec f_ptr = f;
                f_ptr(x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
}

export fn iter_any<AnyIter: Iterator<AnyItem>, AnyItem>(iter: AnyIter, pred: fn(AnyItem) -> bool) -> bool {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return true;
                }
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return false;
}

export fn iter_all<AllIter: Iterator<AllItem>, AllItem>(iter: AllIter, pred: fn(AllItem) -> bool) -> bool {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                } else {
                    return false;
                }
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return true;
}

export fn iter_find<FindIter: Iterator<FindItem>, FindItem>(iter: FindIter, pred: fn(FindItem) -> bool) -> Option<FindItem> {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return Option::Some(x);
                }
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return Option::None;
}

export fn iter_position<PosIter: Iterator<PosItem>, PosItem>(iter: PosIter, pred: fn(PosItem) -> bool) -> Option<u64> {
    dec rw it = iter;
    dec rw idx: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return Option::Some(idx);
                }
                idx = idx + (1 as u64);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return Option::None;
}

export fn iter_nth<NthIter: Iterator<NthItem>, NthItem>(iter: NthIter, n: u64) -> Option<NthItem> {
    dec rw it = iter;
    dec rw idx: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                if idx == n {
                    return Option::Some(x);
                }
                idx = idx + (1 as u64);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return Option::None;
}

export fn iter_last<LastIter: Iterator<LastItem>, LastItem>(iter: LastIter) -> Option<LastItem> {
    dec rw it = iter;
    dec rw last: Option<LastItem> = Option::None;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                last = Option::Some(x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return last;
}

export fn iter_sum_i32<SumIter: Iterator<i32>>(iter: SumIter) -> i32 {
    dec rw it = iter;
    dec rw acc: i32 = 0;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                acc = acc + x;
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return acc;
}
