import <core/panic>;

#[lang("option")]
export enum Option<T> {
    #[lang("some")]
    Some(T),
    #[lang("none")]
    None,
}

impl<T> Option<T> {
    export fn is_some(self: &Self) -> bool {
        match *self {
            Option::Some(_) -> true,
            Option::None -> false,
        }
    }

    export fn is_none(self: &Self) -> bool {
        match *self {
            Option::Some(_) -> false,
            Option::None -> true,
        }
    }

    export fn as_ref(self: &Self) -> Option<&T> life_from(self) {
        if self.is_some() {
            unsafe {
                dec val_ptr = ((self as *Self as u64) + (4 as u64)) as *T;
                return Option::Some(&*val_ptr);
            }
        }
        return Option::None;
    }

    export fn as_mut(self: &rw Self) -> Option<&rw T> life_from(self) {
        if self.is_some() {
            unsafe {
                dec val_ptr = ((self as *rw Self as u64) + (4 as u64)) as *rw T;
                return Option::Some(&rw *val_ptr);
            }
        }
        return Option::None;
    }

    export fn ok(self: Self) -> Option<T> {
        return self;
    }

    export fn unwrap(self: Self) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> __luna_panic(),
        }
    }

    export fn unwrap_or(self: Self, default: T) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> default,
        }
    }

    export fn map<U>(self: Self, f: fn(T) -> U) -> Option<U> {
        match self {
            Option::Some(val) -> Option::Some(f(val)),
            Option::None -> Option::None,
        }
    }

    export fn and_then<U>(self: Self, f: fn(T) -> Option<U>) -> Option<U> {
        return match self {
            Option::Some(val) -> f(val),
            Option::None -> Option::None,
        };
    }

    export fn unwrap_or_else(self: Self, f: fn() -> T) -> T {
        return match self {
            Option::Some(val) -> val,
            Option::None -> f(),
        };
    }

    export fn or_else(self: Self, f: fn() -> Option<T>) -> Option<T> {
        return match self {
            Option::Some(val) -> Option::Some(val),
            Option::None -> f(),
        };
    }

    export fn filter(self: Self, pred: fn(&T) -> bool) -> Option<T> {
        match self {
            Option::Some(val) -> {
                dec p_fn = pred;
                if p_fn(&val) {
                    return Option::Some(val);
                }
                return Option::None;
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}
