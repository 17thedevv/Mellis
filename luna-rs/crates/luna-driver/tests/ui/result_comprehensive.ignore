module mock_core {
    export enum Result<T, E> {
        Ok(T),
        Err(E),
    }

    export struct Error {
        code: i32,
    }

    fn mock_internal() {}
}

// 1. mock_core::Result<T, E> generic function
fn unwrap_or_default<T>(res: mock_core::Result<T, mock_core::Error>, default: T) -> T {
    match res {
        mock_core::Result::Ok(val) -> val,
        mock_core::Result::Err(e) -> default,
    }
}

// 2. mock_core::Result<&T, E>
fn get_ref(val: &i32) -> mock_core::Result<&i32, mock_core::Error> {
    if *val == 0 {
        return mock_core::Result::Err(mock_core::Error { code: 1 });
    }
    return mock_core::Result::Ok(val);
}

// 3. mock_core::Result<T, &E>
fn get_with_err_ref(val: i32, err: &mock_core::Error) -> mock_core::Result<i32, &mock_core::Error> {
    if val == 0 {
        return mock_core::Result::Err(err);
    }
    return mock_core::Result::Ok(val);
}

// 4. Nested mock_core::Result
fn nested(val: i32) -> mock_core::Result<mock_core::Result<i32, mock_core::Error>, mock_core::Error> {
    if val == 0 {
        return mock_core::Result::Err(mock_core::Error { code: 0 });
    }
    return mock_core::Result::Ok(mock_core::Result::Ok(val));
}

// 5. Trait bound on T
trait Display {
    fn show(self: &Self);
}

fn print_ok<T: Display, E>(res: mock_core::Result<T, E>) {
    match res {
        mock_core::Result::Ok(v) -> v.show(),
        mock_core::Result::Err(e) -> {},
    }
}

// 6. Type with Drop
struct Droppable {
    val: i32,
}

impl Droppable {
    fn drop(self: *rw Self) {
        // Drop logic
    }
}

fn test_drop() {
    dec ok_res: mock_core::Result<Droppable, mock_core::Error> = mock_core::Result::Ok(Droppable { val: 42 });
    dec err_res: mock_core::Result<Droppable, mock_core::Error> = mock_core::Result::Err(mock_core::Error { code: 500 });
}

fn main() {
    dec err = mock_core::Error { code: 0 };
    
    dec a: mock_core::Result<i32, mock_core::Error> = mock_core::Result::Ok(10);
    dec b: mock_core::Result<&i32, mock_core::Error> = mock_core::Result::Err(mock_core::Error { code: 2 });
    dec c: mock_core::Result<i32, &mock_core::Error> = mock_core::Result::Ok(20);
    dec d: mock_core::Result<mock_core::Result<i32, mock_core::Error>, mock_core::Error> = mock_core::Result::Ok(mock_core::Result::Ok(30));
    
    dec x = 10;
    dec ref_val = get_ref(&x);
    dec err_ref = get_with_err_ref(10, &err);
    
    test_drop();
}
