import <hashmap>;
import <hash>;
import <cmp>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;
import <__lang_drop>;
import <clone>;

module std {
    export struct SetIntoIter<T> {
        private map: MapIntoIter<T, ()>,
    };

    impl<T> SetIntoIter<T> {
        export fn next(self: &rw Self) -> Option<T> {
            dec opt = self.map.next();
            match opt {
                Option::Some(tup) -> {
                    return Option::Some(tup.0);
                }
                Option::None -> {
                    return Option::None;
                }
            }
        }
    }

    impl<T> Iterator<T> for SetIntoIter<T> {
        fn next(self: &rw Self) -> Option<T> {
            return self.next();
        }
    }


    export struct SetIter<T> {
        private keys: Keys<T, ()>,
    };

    impl<T> SetIter<T> {
        export fn next(self: &rw Self) -> Option<&T> {
            return self.keys.next();
        }
    }

    impl<T> Iterator<&T> for SetIter<T> {
        fn next(self: &rw Self) -> Option<&T> {
            return self.keys.next();
        }
    }

    export struct HashSet<T> {
        private map: HashMap<T, ()>,
    };

    export fn hashset_new<T>() -> HashSet<T> {
        return HashSet {
            map: hashmap_new<T, ()>(),
        };
    }

    export fn hashset_with_capacity<T>(capacity: u64) -> HashSet<T> {
        return HashSet {
            map: hashmap_with_capacity<T, ()>(capacity),
        };
    }

    impl<T: Hash + Eq> HashSet<T> {
        export fn len(self: &Self) -> u64 {
            return self.map.len();
        }

        export fn capacity(self: &Self) -> u64 {
            return self.map.capacity();
        }

        export fn is_empty(self: &Self) -> bool {
            return self.map.is_empty();
        }

        export fn insert(self: &rw Self, value: T) -> bool {
            return self.map.insert(value, ());
        }

        export fn contains(self: &Self, value: &T) -> bool {
            return self.map.contains_key(value);
        }

        export fn remove(self: &rw Self, value: &T) -> bool {
            return self.map.remove(value);
        }

        export fn clear(self: &rw Self) {
            self.map.clear();
        }

        export fn iter(self: &Self) -> SetIter<T> {
            return SetIter<T> {
                keys: self.map.keys(),
            };
        }

        export fn into_iter(self: Self) -> SetIntoIter<T> {
            return SetIntoIter<T> {
                map: self.map.into_iter(),
            };
        }
    }

    impl<T: Hash + Eq + Clone> HashSet<T> {
        export fn union_owned(self: &Self, other: &Self) -> HashSet<T> {
            return std::union_owned<T>(self, other);
        }

        export fn intersection_owned(self: &Self, other: &Self) -> HashSet<T> {
            return std::intersection_owned<T>(self, other);
        }

        export fn difference_owned(self: &Self, other: &Self) -> HashSet<T> {
            return std::difference_owned<T>(self, other);
        }
    }

    export fn union_owned<T: Clone + Eq + Hash>(a: &HashSet<T>, b: &HashSet<T>) -> HashSet<T> {
        dec rw result = hashset_new<T>();
        dec rw it_a = a.iter();
        while true {
            dec opt = it_a.next();
            match opt {
                Option::Some(elem) -> {
                    result.insert((*elem).clone());
                },
                Option::None -> {
                    break;
                },
            }
        }
        dec rw it_b = b.iter();
        while true {
            dec opt = it_b.next();
            match opt {
                Option::Some(elem) -> {
                    result.insert((*elem).clone());
                },
                Option::None -> {
                    break;
                },
            }
        }
        return result;
    }

    export fn intersection_owned<T: Clone + Eq + Hash>(a: &HashSet<T>, b: &HashSet<T>) -> HashSet<T> {
        dec rw result = hashset_new<T>();
        dec rw it_a = a.iter();
        while true {
            dec opt = it_a.next();
            match opt {
                Option::Some(elem) -> {
                    if b.contains(elem) {
                        result.insert((*elem).clone());
                    }
                },
                Option::None -> {
                    break;
                },
            }
        }
        return result;
    }

    export fn difference_owned<T: Clone + Eq + Hash>(a: &HashSet<T>, b: &HashSet<T>) -> HashSet<T> {
        dec rw result = hashset_new<T>();
        dec rw it_a = a.iter();
        while true {
            dec opt = it_a.next();
            match opt {
                Option::Some(elem) -> {
                    if b.contains(elem) == false {
                        result.insert((*elem).clone());
                    }
                },
                Option::None -> {
                    break;
                },
            }
        }
        return result;
    }
}

export fn hashset_union_owned<T: Clone + Eq + Hash>(a: &std::HashSet<T>, b: &std::HashSet<T>) -> std::HashSet<T> {
    return std::union_owned<T>(a, b);
}

export fn hashset_intersection_owned<T: Clone + Eq + Hash>(a: &std::HashSet<T>, b: &std::HashSet<T>) -> std::HashSet<T> {
    return std::intersection_owned<T>(a, b);
}

export fn hashset_difference_owned<T: Clone + Eq + Hash>(a: &std::HashSet<T>, b: &std::HashSet<T>) -> std::HashSet<T> {
    return std::difference_owned<T>(a, b);
}

export type SetIter<T> = std::SetIter<T>;
export type SetIntoIter<T> = std::SetIntoIter<T>;
export type HashSet<T> = std::HashSet<T>;
export fn hashset_new<T>() -> HashSet<T> { return std::hashset_new<T>(); }
export fn hashset_with_capacity<T>(capacity: u64) -> HashSet<T> { return std::hashset_with_capacity<T>(capacity); }

impl<T> IntoIterator<T, SetIntoIter<T>> for std::HashSet<T> {
    fn into_iter(self: Self) -> SetIntoIter<T> {
        return self.into_iter();
    }
}

