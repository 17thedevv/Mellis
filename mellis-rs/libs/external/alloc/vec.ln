import <__alloc_global>;
import <slice>;
import <ptr>;
import <mem>;
import <__lang_drop>;
import <core/panic>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;
import <clone>;
import <cmp>;

export struct Vec<T> {
    private ptr: *rw T,
    private len: u64,
    private cap: u64,
};

export fn vec_new<T>() -> Vec<T> {
    return Vec<T> {
        ptr: 0 as u64 as *rw T,
        len: 0 as u64,
        cap: 0 as u64,
    };
}

export fn vec_with_capacity<T>(capacity: u64) -> Vec<T> {
    if capacity == (0 as u64) {
        return vec_new<T>();
    }
    dec size = capacity * (mem::size_of<T>() as u64);
    dec align = mem::align_of<T>() as u64;
    dec ptr = __luna_alloc(size, align) as u64 as *rw T;
    return Vec<T> {
        ptr: ptr,
        len: 0 as u64,
        cap: capacity,
    };
}

export type VecIter<T> = SliceIter<T>;
export type VecIterMut<T> = SliceIterMut<T>;

// =========================================================================
// VecIntoIter: Owned, consuming iterator over Vec<T>
// =========================================================================
export struct VecIntoIter<T> {
    private ptr: *rw T,
    private len: u64,
    private cap: u64,
    private index: u64,
};

impl<T> Iterator<T> for VecIntoIter<T> {
    fn next(self: &rw Self) -> Option<T> {
        if self.index >= self.len {
            return Option::None;
        }
        unsafe {
            dec item_ptr = ptr::add_mut<T>(self.ptr, self.index);
            dec val = ptr::read<T>(item_ptr as *T);
            self.index = self.index + (1 as u64);
            return Option::Some(val);
        }
    }
}

impl<T> Drop for VecIntoIter<T> {
    fn drop(self: &rw Self) {
        while self.index < self.len {
            unsafe {
                dec item_ptr = ptr::add_mut<T>(self.ptr, self.index);
                ptr::drop_in_place<T>(item_ptr);
            }
            self.index = self.index + (1 as u64);
        }
        if self.cap > (0 as u64) {
            dec size = self.cap * (mem::size_of<T>() as u64);
            dec align = mem::align_of<T>() as u64;
            unsafe {
                __luna_dealloc(self.ptr as *rw u8, size, align);
            }
            self.ptr = 0 as u64 as *rw T;
            self.cap = 0 as u64;
            self.len = 0 as u64;
        }
    }
}

// =========================================================================
// IntoIterator implementations for Vec<T>
// =========================================================================

// Owned: consumes Vec
impl<T> IntoIterator<T, VecIntoIter<T>> for Vec<T> {
    fn into_iter(self: Self) -> VecIntoIter<T> {
        dec rw result = VecIntoIter<T> {
            ptr: self.ptr,
            len: self.len,
            cap: self.cap,
            index: 0 as u64,
        };
        self.ptr = 0 as u64 as *rw T;
        self.len = 0 as u64;
        self.cap = 0 as u64;
        return result;
    }
}

impl<T> Vec<T> {
    export fn push(self: &rw Self, item: T) {
        if self.len == self.cap {
            self.grow();
        }
        unsafe {
            dec target_ptr = ptr::add_mut<T>(self.ptr, self.len);
            ptr::write<T>(target_ptr, item);
        }
        self.len = self.len + (1 as u64);
    }

    export fn pop(self: &rw Self) -> Option<T> {
        if self.len == (0 as u64) {
            return Option::None;
        }
        self.len = self.len - (1 as u64);
        unsafe {
            dec target_ptr = ptr::add<T>(self.ptr as *T, self.len);
            return Option::Some(ptr::read<T>(target_ptr));
        }
    }

    export fn clear(self: &rw Self) {
        dec rw i = self.len;
        while i > (0 as u64) {
            i = i - (1 as u64);
            unsafe {
                ptr::drop_in_place<T>(ptr::add_mut<T>(self.ptr, i));
            }
        }
        self.len = 0 as u64;
    }

    export fn insert(self: &rw Self, index: u64, item: T) {
        if index > self.len {
            __luna_panic_default();
        }
        if self.len == self.cap {
            self.grow();
        }
        unsafe {
            dec rw i = self.len;
            while i > index {
                dec src = ptr::add<T>(self.ptr as *T, i - (1 as u64));
                dec dst = ptr::add_mut<T>(self.ptr, i);
                ptr::write<T>(dst, ptr::read<T>(src));
                i = i - (1 as u64);
            }
            dec target = ptr::add_mut<T>(self.ptr, index);
            ptr::write<T>(target, item);
        }
        self.len = self.len + (1 as u64);
    }

    export fn remove(self: &rw Self, index: u64) -> T {
        if index >= self.len {
            __luna_panic_default();
        }
        unsafe {
            dec target = ptr::add<T>(self.ptr as *T, index);
            dec val = ptr::read<T>(target);
            dec rw i = index;
            while i + (1 as u64) < self.len {
                dec src = ptr::add<T>(self.ptr as *T, i + (1 as u64));
                dec dst = ptr::add_mut<T>(self.ptr, i);
                ptr::write<T>(dst, ptr::read<T>(src));
                i = i + (1 as u64);
            }
            self.len = self.len - (1 as u64);
            return val;
        }
    }

    export fn len(self: &Self) -> u64 {
        return self.len;
    }

    export fn capacity(self: &Self) -> u64 {
        return self.cap;
    }

    export fn is_empty(self: &Self) -> bool {
        return self.len == (0 as u64);
    }

    export fn last(self: &Self) -> Option<&T> life_from(self) {
        if self.len == (0 as u64) {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add<T>(self.ptr as *T, self.len - (1 as u64));
            return Option::Some(&*offset_ptr);
        }
    }

    export fn last_mut(self: &rw Self) -> Option<&rw T> life_from(self) {
        if self.len == (0 as u64) {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add_mut<T>(self.ptr, self.len - (1 as u64));
            return Option::Some(&rw *offset_ptr);
        }
    }

    export fn truncate(self: &rw Self, new_len: u64) {
        if new_len >= self.len {
            return;
        }
        dec rw i = self.len;
        while i > new_len {
            i = i - (1 as u64);
            unsafe {
                ptr::drop_in_place<T>(ptr::add_mut<T>(self.ptr, i));
            }
        }
        self.len = new_len;
    }

    export fn get(self: &Self, index: u64) -> Option<&T> life_from(self) {
        if index >= self.len {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add<T>(self.ptr as *T, index);
            return Option::Some(&*offset_ptr);
        }
    }

    export fn get_mut(self: &rw Self, index: u64) -> Option<&rw T> life_from(self) {
        if index >= self.len {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add_mut<T>(self.ptr, index);
            return Option::Some(&rw *offset_ptr);
        }
    }

    export fn as_slice(self: &Self) -> &[T] life_from(self) {
        unsafe {
            return slice_from_raw_parts<T>(self.ptr as *T, self.len);
        }
    }

    export fn as_mut_slice(self: &rw Self) -> &rw [T] life_from(self) {
        unsafe {
            return slice_from_raw_parts_mut<T>(self.ptr, self.len);
        }
    }

    export fn grow(self: &rw Self) {
        dec rw new_cap: u64 = 0 as u64;
        if self.cap == (0 as u64) {
            new_cap = 4 as u64;
        } else {
            new_cap = self.cap * (2 as u64);
        }
        
        dec new_size = new_cap * (mem::size_of<T>() as u64);
        dec align = mem::align_of<T>() as u64;
        dec new_ptr = __luna_alloc(new_size, align) as u64 as *rw T;

        if self.cap > (0 as u64) {
            unsafe {
                ptr::copy<T>(self.ptr as *T, new_ptr, self.len);
            }
            dec old_size = self.cap * (mem::size_of<T>() as u64);
            __luna_dealloc(self.ptr as *rw u8, old_size, align);
        }

        self.ptr = new_ptr;
        self.cap = new_cap;
    }

    export fn iter(self: &Self) -> SliceIter<T> life_from(self) {
        return slice_iter<T>(self.as_slice());
    }

    export fn iter_mut(self: &rw Self) -> SliceIterMut<T> life_from(self) {
        return slice_iter_mut<T>(self.as_mut_slice());
    }

    export fn swap_remove(self: &rw Self, index: u64) -> T {
        if index >= self.len {
            __luna_panic_default();
        }
        dec old_len = self.len;
        dec last = old_len - (1 as u64);
        unsafe {
            dec target = ptr::add<T>(self.ptr as *T, index);
            dec removed = ptr::read<T>(target);
            if index != last {
                dec tail = ptr::add<T>(self.ptr as *T, last);
                dec val = ptr::read<T>(tail);
                dec dst = ptr::add_mut<T>(self.ptr, index);
                ptr::write<T>(dst, val);
            }
            self.len = last;
            return removed;
        }
    }

    export fn retain(self: &rw Self, f: fn(&T) -> bool) {
        dec len = self.len;
        dec rw r: u64 = 0 as u64;
        dec rw w: u64 = 0 as u64;
        dec f_ptr = f;
        while r < len {
            unsafe {
                dec item_ptr = ptr::add<T>(self.ptr as *T, r);
                if f_ptr(&*item_ptr) {
                    if r != w {
                        dec val = ptr::read<T>(item_ptr);
                        dec dst = ptr::add_mut<T>(self.ptr, w);
                        ptr::write<T>(dst, val);
                    }
                    w = w + (1 as u64);
                } else {
                    dec drop_ptr = ptr::add_mut<T>(self.ptr, r);
                    ptr::drop_in_place<T>(drop_ptr);
                }
            }
            r = r + (1 as u64);
        }
        self.len = w;
    }
}

impl<T: Eq> Vec<T> {
    export fn dedup(self: &rw Self) {
        if self.len <= (1 as u64) {
            return;
        }
        dec len = self.len;
        dec rw r: u64 = 1 as u64;
        dec rw w: u64 = 1 as u64;
        while r < len {
            unsafe {
                dec curr_ptr = ptr::add<T>(self.ptr as *T, r);
                dec prev_ptr = ptr::add<T>(self.ptr as *T, w - (1 as u64));
                if (&*curr_ptr).eq(&*prev_ptr) {
                    dec drop_ptr = ptr::add_mut<T>(self.ptr, r);
                    ptr::drop_in_place<T>(drop_ptr);
                } else {
                    if r != w {
                        dec val = ptr::read<T>(curr_ptr);
                        dec dst = ptr::add_mut<T>(self.ptr, w);
                        ptr::write<T>(dst, val);
                    }
                    w = w + (1 as u64);
                }
            }
            r = r + (1 as u64);
        }
        self.len = w;
    }
}

impl<T: Clone> Vec<T> {
    export fn extend_from_slice(self: &rw Self, other: &[T]) {
        dec other_len = other.len as u64;
        dec rw i: u64 = 0 as u64;
        while i < other_len {
            self.push(other[i].clone());
            i = i + (1 as u64);
        }
    }

    export fn resize(self: &rw Self, new_len: u64, value: T) {
        if new_len < self.len {
            self.truncate(new_len);
            return;
        }
        if new_len > self.len {
            dec to_add = new_len - self.len;
            dec rw i: u64 = 0 as u64;
            while i + (1 as u64) < to_add {
                self.push((&value).clone());
                i = i + (1 as u64);
            }
            self.push(value);
            return;
        }
    }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(self: &Self) -> Self {
        dec rw result = vec_with_capacity<T>(self.len);
        dec rw i: u64 = 0 as u64;
        while i < self.len {
            unsafe {
                dec elem = ptr::add<T>(self.ptr as *T, i);
                result.push((&*elem).clone());
            }
            i = i + (1 as u64);
        }
        return result;
    }
}

impl<T: Eq> Eq for Vec<T> {
    fn eq(self: &Self, other: &Self) -> bool {
        if self.len != other.len {
            return false;
        }
        dec rw i: u64 = 0 as u64;
        while i < self.len {
            unsafe {
                dec e1 = ptr::add<T>(self.ptr as *T, i);
                dec e2 = ptr::add<T>(other.ptr as *T, i);
                if (&*e1).eq(&*e2) == false {
                    return false;
                }
            }
            i = i + (1 as u64);
        }
        return true;
    }
}

impl<T> Drop for Vec<T> {
    fn drop(self: &rw Self) {
        dec rw i = self.len;
        while i > (0 as u64) {
            i = i - (1 as u64);
            unsafe {
                ptr::drop_in_place<T>(ptr::add_mut<T>(self.ptr, i));
            }
        }
        if self.cap > (0 as u64) {
            dec old_size = self.cap * (mem::size_of<T>() as u64);
            __luna_dealloc(self.ptr as *rw u8, old_size, mem::align_of<T>() as u64);
        }
    }
}
