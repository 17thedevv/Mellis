#[lang("drop")]
export trait Drop {
    #[lang("drop_fn")]
    fn drop(self: &rw Self);
}

#[lang("copy")]
export trait Copy {}

#[lang("from_residual")]
export trait FromResidual<R> {
    #[lang("from_residual_fn")]
    fn from_residual(residual: R) -> Self;
}

#[lang("try")]
export trait Try {
    type Output;
    type Residual;
    
    #[lang("try_from_output")]
    fn from_output(v: Self::Output) -> Self;
    
    #[lang("try_branch")]
    fn branch(self: Self) -> ControlFlow<Self::Residual, Self::Output>;
}

#[lang("control_flow")]
export enum ControlFlow<B, C> {
    #[lang("continue")]
    Continue(C),
    #[lang("break")]
    Break(B),
}

export enum Result<T, E> {
    Ok(T),
    Err(E),
}

export enum Infallible {
    InfallibleVariant,
}
impl<T, E> FromResidual<Result<Infallible, E> > for Result<T, E> {
    fn from_residual(residual: Result<Infallible, E>) -> Self {
        return match residual {
            Result::Err(e) -> Result::Err(e),
            Result::Ok(_) -> __mellis_panic(),
        };
    }
}

impl<T, E> Try for Result<T, E> {
    type Output = T;
    type Residual = Result<Infallible, E>;
    
    fn from_output(v: T) -> Self {
        return Result::Ok(v);
    }
    
    fn branch(self: Self) -> ControlFlow<Result<Infallible, E>, T> {
        return match self {
            Result::Ok(v) -> ControlFlow::Continue(v),
            Result::Err(e) -> ControlFlow::Break(Result::Err(e)),
        };
    }
}

impl<T, E> Result<T, E> {
    export fn is_ok(self: &Self) -> bool {
        match *self {
            Result::Ok(_) -> true,
            Result::Err(_) -> false,
        }
    }

    export fn is_err(self: &Self) -> bool {
        match *self {
            Result::Ok(_) -> false,
            Result::Err(_) -> true,
        }
    }

    export fn as_ref(self: &Self) -> Result<&T, &E> life_from(self) {
        if self.is_ok() {
            unsafe {
                dec val_ptr = ((self as *Self as u64) + (4 as u64)) as *T;
                return Result::Ok(&*val_ptr);
            }
        }
        unsafe {
            dec err_ptr = ((self as *Self as u64) + (4 as u64)) as *E;
            return Result::Err(&*err_ptr);
        }
    }

    export fn as_mut(self: &rw Self) -> Result<&rw T, &rw E> life_from(self) {
        if self.is_ok() {
            unsafe {
                dec val_ptr = ((self as *rw Self as u64) + (4 as u64)) as *rw T;
                return Result::Ok(&rw *val_ptr);
            }
        }
        unsafe {
            dec err_ptr = ((self as *rw Self as u64) + (4 as u64)) as *rw E;
            return Result::Err(&rw *err_ptr);
        }
    }

    export fn ok(self: Self) -> Option<T> {
        return match self {
            Result::Ok(val) -> Option::Some(val),
            Result::Err(e) -> Option::None,
        };
    }

    export fn err(self: Self) -> Option<E> {
        return match self {
            Result::Ok(val) -> Option::None,
            Result::Err(e) -> Option::Some(e),
        };
    }

    export fn unwrap(self: Self) -> T {
        match self {
            Result::Ok(val) -> val,
            Result::Err(_) -> __mellis_panic(),
        }
    }
}

export extern fn __mellis_panic() -> !;

export enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    export fn is_some(self: &Self) -> bool {
        match *self {
            Option::Some(_) -> true,
            Option::None -> false,
        }
    }

    export fn is_none(self: &Self) -> bool {
        match *self {
            Option::Some(_) -> false,
            Option::None -> true,
        }
    }

    export fn as_ref(self: &Self) -> Option<&T> life_from(self) {
        if self.is_some() {
            unsafe {
                dec val_ptr = ((self as *Self as u64) + (4 as u64)) as *T;
                return Option::Some(&*val_ptr);
            }
        }
        return Option::None;
    }

    export fn as_mut(self: &rw Self) -> Option<&rw T> life_from(self) {
        if self.is_some() {
            unsafe {
                dec val_ptr = ((self as *rw Self as u64) + (4 as u64)) as *rw T;
                return Option::Some(&rw *val_ptr);
            }
        }
        return Option::None;
    }

    export fn ok_or<E>(self: Self, err: E) -> Result<T, E> {
        return match self {
            Option::Some(val) -> Result::Ok(val),
            Option::None -> Result::Err(err),
        };
    }

    export fn ok(self: Self) -> Option<T> {
        return self;
    }

    export fn unwrap(self: Self) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> __mellis_panic(),
        }
    }

    export fn unwrap_or(self: Self, default: T) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> default,
        }
    }

    export fn map<U>(self: Self, f: fn(T) -> U) -> Option<U> {
        match self {
            Option::Some(val) -> Option::Some(f(val)),
            Option::None -> Option::None,
        }
    }
}

export trait Iterator<Item> {
    fn next(self: &rw Self) -> Option<Item>;
}

export trait IntoIterator<Item, IntoIter> {
    fn into_iter(self: Self) -> IntoIter;
}

export trait Clone {
    fn clone(self: &Self) -> Self;
}

export trait Eq {
    fn eq(self: &Self, other: &Self) -> bool;
}

export trait Ord {
    fn cmp(self: &Self, other: &Self) -> i32;
}

export trait Hash {
    fn hash(self: &Self) -> u64;
}

impl Eq for bool { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for char { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u8 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u16 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u32 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u64 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for usize { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i8 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i16 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i32 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i64 { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }
impl Eq for isize { fn eq(self: &Self, other: &Self) -> bool { return *self == *other; } }

impl Clone for bool { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for char { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for u8 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for u16 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for u32 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for u64 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for usize { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for i8 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for i16 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for i32 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for i64 { fn clone(self: &Self) -> Self { return *self; } }
impl Clone for isize { fn clone(self: &Self) -> Self { return *self; } }

impl Hash for bool {
    fn hash(self: &Self) -> u64 {
        if *self {
            return 1 as u64;
        } else {
            return 0 as u64;
        }
    }
}

impl Hash for char {
    fn hash(self: &Self) -> u64 {
        return (*self as u32) as u64;
    }
}

impl Hash for u8 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for u16 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for u32 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for u64 { fn hash(self: &Self) -> u64 { return *self; } }
impl Hash for usize { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for i8 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for i16 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for i32 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for i64 { fn hash(self: &Self) -> u64 { return *self as u64; } }
impl Hash for isize { fn hash(self: &Self) -> u64 { return *self as u64; } }

// NOTE: `slice_from_raw_parts` and `slice_from_raw_parts_mut` are unsafe intrinsic boundaries
// bridging raw pointers to fat-pointer slices. They must NOT be treated as a precedent for safe
// reference construction without explicit lifetime provenance contracts.
export unsafe fn slice_from_raw_parts<T>(ptr: *T, len: u64) -> &[T];
export unsafe fn slice_from_raw_parts_mut<T>(ptr: *rw T, len: u64) -> &rw [T];

module mem {
    export unsafe fn copy(src: *u8, dst: *rw u8, bytes: u64) {
        dec rw i: u64 = 0 as u64;
        while i < bytes {
            dec s = (src as u64 + i) as *u8;
            dec d = (dst as u64 + i) as *rw u8;
            *d = *s;
            i = i + (1 as u64);
        }
    }

    export unsafe fn set(dst: *rw u8, val: u8, bytes: u64) {
        dec rw i: u64 = 0 as u64;
        while i < bytes {
            dec d = (dst as u64 + i) as *rw u8;
            *d = val;
            i = i + (1 as u64);
        }
    }

    export unsafe fn zero(dst: *rw u8, bytes: u64) {
        set(dst, 0 as u8, bytes);
    }

    export fn size_of<T>() -> u64 {
        return sizeof(T) as u64;
    }

    export fn align_of<T>() -> u64 {
        return alignof(T) as u64;
    }
}

module ptr {
    export unsafe fn read<T>(src: *T) -> T {
        return *src;
    }

    export unsafe fn write<T>(dst: *rw T, val: T) {
        *dst = val;
    }

    export unsafe intrinsic fn drop_in_place<T>(p: *rw T);

    export unsafe fn add<T>(p: *T, count: u64) -> *T {
        return (p as u64 + (count * (sizeof(T) as u64))) as *T;
    }

    export unsafe fn add_mut<T>(p: *rw T, count: u64) -> *rw T {
        return (p as u64 + (count * (sizeof(T) as u64))) as *rw T;
    }

    export unsafe fn offset<T>(p: *T, count: i64) -> *T {
        return (p as u64 + (count as u64 * (sizeof(T) as u64))) as *T;
    }

    export unsafe fn offset_mut<T>(p: *rw T, count: i64) -> *rw T {
        return (p as u64 + (count as u64 * (sizeof(T) as u64))) as *rw T;
    }

    export unsafe fn diff<T>(a: *T, b: *T) -> i64 {
        return ((a as i64) - (b as i64)) / (sizeof(T) as i64);
    }

    export unsafe fn copy<T>(src: *T, dst: *rw T, count: u64) {
        dec rw i: u64 = 0 as u64;
        while i < count {
            dec s = ptr::add<T>(src, i);
            dec d = ptr::add_mut<T>(dst, i);
            ptr::write<T>(d, ptr::read<T>(s));
            i = i + (1 as u64);
        }
    }
}

// =========================================================================
// SliceIter: Borrowed iterator over slice
// ITER-4: A borrowed collection iterator MUST NOT transfer ownership
// ITER-9: SliceIter<T>::Item is &T
// ITER-10: SliceIter does not move/drop backing elements
// =========================================================================
export struct SliceIter<T> {
    private ptr: *T,
    private end: *T,
}

impl<T> SliceIter<T> {
    // Shared borrow iteration - returns reference to backing element
    export fn next_ref(self: &rw Self) -> Option<&T> life_from(self) {
        if (self.ptr as u64) >= (self.end as u64) {
            return Option::None;
        }
        unsafe {
            dec item_ptr = self.ptr;
            self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *T;
            return Option::Some(&*item_ptr);
        }
    }
}

// ITER-9: Item is &T (borrowed reference, not owned value)
impl<T> Iterator<&T> for SliceIter<T> {
    fn next(self: &rw Self) -> Option<&T> {
        if (self.ptr as u64) >= (self.end as u64) {
            return Option::None;
        }
        unsafe {
            dec item_ptr = self.ptr;
            self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *T;
            return Option::Some(&*item_ptr);
        }
    }
}


export struct SliceIterMut<T> {
    private ptr: *rw T;
    private end: *rw T;
}

impl<T> SliceIterMut<T> {
    export fn next_mut(self: &rw Self) -> Option<&rw T> life_from(self) {
        if (self.ptr as u64) >= (self.end as u64) {
            return Option::None;
        }
        unsafe {
            dec item_ptr = self.ptr;
            self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *rw T;
            return Option::Some(&rw *item_ptr);
        }
    }
}

impl<T> Iterator<&rw T> for SliceIterMut<T> {
    export fn next(self: &rw Self) -> Option<&rw T> {
        if (self.ptr as u64) >= (self.end as u64) {
            return Option::None;
        }
        unsafe {
            dec item_ptr = self.ptr;
            self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *rw T;
            return Option::Some(&rw *item_ptr);
        }
    }
}

export fn slice_iter<T>(s: &[T]) -> SliceIter<T> life_from(s) {
    dec end_ptr = (s.data as u64 + (s.len as u64 * (sizeof(T) as u64))) as *T;
    return SliceIter<T> {
        ptr: s.data as *T,
        end: end_ptr,
    };
}

export fn slice_iter_mut<T>(s: &rw [T]) -> SliceIterMut<T> life_from(s) {
    dec end_ptr = (s.data as u64 + (s.len as u64 * (sizeof(T) as u64))) as *rw T;
    return SliceIterMut<T> {
        ptr: s.data as *rw T,
        end: end_ptr,
    };
}

// =========================================================================
// Iterator Adapters: Map, Filter, Enumerate, Take, Skip, Zip
// =========================================================================

export struct Map<I, Item, Out> {
    private iter: I,
    private f: fn(Item) -> Out,
}

impl<I: Iterator<Item>, Item, Out> Iterator<Out> for Map<I, Item, Out> {
    fn next(self: &rw Self) -> Option<Out> {
        dec opt = self.iter.next();
        match opt {
            Option::Some(x) -> {
                dec f_ptr = self.f;
                return Option::Some(f_ptr(x));
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export struct Filter<I, Item> {
    private iter: I,
    // Predicate takes Item directly (borrowed iterators: Item=&T, owned: Item=T)
    private pred: fn(Item) -> bool,
}

impl<I: Iterator<Item>, Item> Iterator<Item> for Filter<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        dec rw running = true;
        while running {
            dec opt = self.iter.next();
            match opt {
                Option::Some(x) -> {
                    dec p_ptr = self.pred;
                    if p_ptr(x) {
                        return Option::Some(x);
                    }
                },
                Option::None -> {
                    running = false;
                },
            }
        }
        return Option::None;
    }
}

export struct Enumerate<I, Item> {
    private iter: I,
    private count: u64,
}

impl<I: Iterator<Item>, Item> Iterator<(u64, Item)> for Enumerate<I, Item> {
    fn next(self: &rw Self) -> Option<(u64, Item)> {
        dec opt = self.iter.next();
        match opt {
            Option::Some(x) -> {
                dec cur = self.count;
                self.count = self.count + (1 as u64);
                return Option::Some((cur, x));
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export struct Take<I, Item> {
    private iter: I,
    private remaining: u64,
}

impl<I: Iterator<Item>, Item> Iterator<Item> for Take<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        if self.remaining == (0 as u64) {
            return Option::None;
        }
        dec item_opt = self.iter.next();
        match item_opt {
            Option::Some(x) -> {
                self.remaining = self.remaining - (1 as u64);
                return Option::Some(x);
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export struct Skip<I, Item> {
    private iter: I,
    private to_skip: u64,
}

impl<I: Iterator<Item>, Item> Iterator<Item> for Skip<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        while self.to_skip > (0 as u64) {
            self.to_skip = self.to_skip - (1 as u64);
            dec opt = self.iter.next();
            match opt {
                Option::Some(_) -> {},
                Option::None -> {
                    return Option::None;
                },
            }
        }
        return self.iter.next();
    }
}

export struct Zip<A, B, ItemA, ItemB> {
    private a: A,
    private b: B,
}

impl<A: Iterator<ItemA>, B: Iterator<ItemB>, ItemA, ItemB> Iterator<(ItemA, ItemB)> for Zip<A, B, ItemA, ItemB> {
    fn next(self: &rw Self) -> Option<(ItemA, ItemB)> {
        dec opt_a = self.a.next();
        match opt_a {
            Option::Some(x) -> {
                dec opt_b = self.b.next();
                match opt_b {
                    Option::Some(y) -> {
                        return Option::Some((x, y));
                    },
                    Option::None -> {
                        return Option::None;
                    },
                }
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export fn iter_map<I: Iterator<Item>, Item, Out>(iter: I, f: fn(Item) -> Out) -> Map<I, Item, Out> {
    return Map<I, Item, Out> {
        iter: iter,
        f: f,
    };
}

export fn iter_filter<I: Iterator<Item>, Item>(iter: I, pred: fn(Item) -> bool) -> Filter<I, Item> {
    return Filter<I, Item> {
        iter: iter,
        pred: pred,
    };
}

export fn iter_enumerate<I: Iterator<Item>, Item>(iter: I) -> Enumerate<I, Item> {
    return Enumerate<I, Item> {
        iter: iter,
        count: 0 as u64,
    };
}

export fn iter_take<I: Iterator<Item>, Item>(iter: I, n: u64) -> Take<I, Item> {
    return Take<I, Item> {
        iter: iter,
        remaining: n,
    };
}

export fn iter_skip<I: Iterator<Item>, Item>(iter: I, n: u64) -> Skip<I, Item> {
    return Skip<I, Item> {
        iter: iter,
        to_skip: n,
    };
}

export fn iter_zip<A: Iterator<ItemA>, B: Iterator<ItemB>, ItemA, ItemB>(a: A, b: B) -> Zip<A, B, ItemA, ItemB> {
    return Zip<A, B, ItemA, ItemB> {
        a: a,
        b: b,
    };
}

// =========================================================================
// Terminal Consumers: fold, count, for_each, any, all, find
// =========================================================================

export fn iter_fold<FoldIter: Iterator<FoldItem>, FoldItem, B>(iter: FoldIter, init: B, f: fn(B, FoldItem) -> B) -> B {
    dec rw it = iter;
    dec rw acc = init;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec f_ptr = f;
                acc = f_ptr(acc, x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return acc;
}

export fn iter_count<CountIter: Iterator<CountItem>, CountItem>(iter: CountIter) -> u64 {
    dec rw it = iter;
    dec rw count: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(_) -> {
                count = count + (1 as u64);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return count;
}

export fn iter_for_each<EachIter: Iterator<EachItem>, EachItem>(iter: EachIter, f: fn(EachItem)) {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec f_ptr = f;
                f_ptr(x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
}

export fn iter_any<AnyIter: Iterator<AnyItem>, AnyItem>(iter: AnyIter, pred: fn(AnyItem) -> bool) -> bool {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return true;
                }
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return false;
}

export fn iter_all<AllIter: Iterator<AllItem>, AllItem>(iter: AllIter, pred: fn(AllItem) -> bool) -> bool {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                } else {
                    return false;
                }
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return true;
}

export fn iter_find<FindIter: Iterator<FindItem>, FindItem>(iter: FindIter, pred: fn(FindItem) -> bool) -> Option<FindItem> {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return Option::Some(x);
                }
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return Option::None;
}




