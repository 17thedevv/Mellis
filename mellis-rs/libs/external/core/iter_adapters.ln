import <__lang_option>;
import <__lang_iterator>;
import <clone>;

// =========================================================================
// Iterator Adapters: Map, Filter, Enumerate, Take, Skip, Zip
// =========================================================================

export struct Map<I, Item, Out> {
    private iter: I,
    private f: fn(Item) -> Out,
};

impl<I: Iterator<Item>, Item, Out> Iterator<Out> for Map<I, Item, Out> {
    fn next(self: &rw Self) -> Option<Out> {
        dec opt = self.iter.next();
        match opt {
            Option::Some(x) -> {
                dec f_ptr = self.f;
                return Option::Some(f_ptr(x));
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export struct Filter<I, Item> {
    private iter: I,
    // Predicate takes Item directly (borrowed iterators: Item=&T, owned: Item=T)
    private pred: fn(Item) -> bool,
};

impl<I: Iterator<Item>, Item> Iterator<Item> for Filter<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        dec rw running = true;
        while running {
            dec opt = self.iter.next();
            match opt {
                Option::Some(x) -> {
                    dec p_ptr = self.pred;
                    if p_ptr(x) {
                        return Option::Some(x);
                    }
                },
                Option::None -> {
                    running = false;
                },
            }
        }
        return Option::None;
    }
}

export struct Enumerate<I, Item> {
    private iter: I,
    private count: u64,
};

impl<I: Iterator<Item>, Item> Iterator<(u64, Item)> for Enumerate<I, Item> {
    fn next(self: &rw Self) -> Option<(u64, Item)> {
        dec opt = self.iter.next();
        match opt {
            Option::Some(x) -> {
                dec cur = self.count;
                self.count = self.count + (1 as u64);
                return Option::Some((cur, x));
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export struct Take<I, Item> {
    private iter: I,
    private remaining: u64,
};

impl<I: Iterator<Item>, Item> Iterator<Item> for Take<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        if self.remaining == (0 as u64) {
            return Option::None;
        }
        dec item_opt = self.iter.next();
        match item_opt {
            Option::Some(x) -> {
                self.remaining = self.remaining - (1 as u64);
                return Option::Some(x);
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export struct Skip<I, Item> {
    private iter: I,
    private to_skip: u64,
};

impl<I: Iterator<Item>, Item> Iterator<Item> for Skip<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        while self.to_skip > (0 as u64) {
            self.to_skip = self.to_skip - (1 as u64);
            dec opt = self.iter.next();
            match opt {
                Option::Some(_) -> {},
                Option::None -> {
                    return Option::None;
                },
            }
        }
        return self.iter.next();
    }
}

export struct Zip<A, B, ItemA, ItemB> {
    private a: A,
    private b: B,
};

impl<A: Iterator<ItemA>, B: Iterator<ItemB>, ItemA, ItemB> Iterator<(ItemA, ItemB)> for Zip<A, B, ItemA, ItemB> {
    fn next(self: &rw Self) -> Option<(ItemA, ItemB)> {
        dec opt_a = self.a.next();
        match opt_a {
            Option::Some(x) -> {
                dec opt_b = self.b.next();
                match opt_b {
                    Option::Some(y) -> {
                        return Option::Some((x, y));
                    },
                    Option::None -> {
                        return Option::None;
                    },
                }
            },
            Option::None -> {
                return Option::None;
            },
        }
    }
}

export fn iter_map<I: Iterator<Item>, Item, Out>(iter: I, f: fn(Item) -> Out) -> Map<I, Item, Out> {
    return Map<I, Item, Out> {
        iter: iter,
        f: f,
    };
}

export fn iter_filter<I: Iterator<Item>, Item>(iter: I, pred: fn(Item) -> bool) -> Filter<I, Item> {
    return Filter<I, Item> {
        iter: iter,
        pred: pred,
    };
}

export fn iter_enumerate<I: Iterator<Item>, Item>(iter: I) -> Enumerate<I, Item> {
    return Enumerate<I, Item> {
        iter: iter,
        count: 0 as u64,
    };
}

export fn iter_take<I: Iterator<Item>, Item>(iter: I, n: u64) -> Take<I, Item> {
    return Take<I, Item> {
        iter: iter,
        remaining: n,
    };
}

export fn iter_skip<I: Iterator<Item>, Item>(iter: I, n: u64) -> Skip<I, Item> {
    return Skip<I, Item> {
        iter: iter,
        to_skip: n,
    };
}

export fn iter_zip<A: Iterator<ItemA>, B: Iterator<ItemB>, ItemA, ItemB>(a: A, b: B) -> Zip<A, B, ItemA, ItemB> {
    return Zip<A, B, ItemA, ItemB> {
        a: a,
        b: b,
    };
}

// =========================================================================
// Chain, FilterMap, TakeWhile, Peekable
// =========================================================================

export struct Chain<A, B, Item> {
    private a: A,
    private b: B,
    private in_first: bool,
};

impl<A: Iterator<Item>, B: Iterator<Item>, Item> Iterator<Item> for Chain<A, B, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        if self.in_first {
            dec opt = self.a.next();
            match opt {
                Option::Some(x) -> {
                    return Option::Some(x);
                },
                Option::None -> {
                    self.in_first = false;
                },
            }
        }
        return self.b.next();
    }
}

export fn iter_chain<A: Iterator<Item>, B: Iterator<Item>, Item>(a: A, b: B) -> Chain<A, B, Item> {
    return Chain<A, B, Item> {
        a: a,
        b: b,
        in_first: true,
    };
}

export struct FilterMap<I, Item, Out> {
    private iter: I,
    private f: fn(Item) -> Option<Out>,
};

impl<I: Iterator<Item>, Item, Out> Iterator<Out> for FilterMap<I, Item, Out> {
    fn next(self: &rw Self) -> Option<Out> {
        dec rw running = true;
        while running {
            dec opt = self.iter.next();
            match opt {
                Option::Some(x) -> {
                    dec f_ptr = self.f;
                    dec mapped = f_ptr(x);
                    match mapped {
                        Option::Some(y) -> {
                            return Option::Some(y);
                        },
                        Option::None -> {},
                    }
                },
                Option::None -> {
                    running = false;
                },
            }
        }
        return Option::None;
    }
}

export fn iter_filter_map<I: Iterator<Item>, Item, Out>(iter: I, f: fn(Item) -> Option<Out>) -> FilterMap<I, Item, Out> {
    return FilterMap<I, Item, Out> {
        iter: iter,
        f: f,
    };
}

export struct TakeWhile<I, Item> {
    private iter: I,
    private pred: fn(Item) -> bool,
    private done: bool,
};

impl<I: Iterator<Item>, Item> Iterator<Item> for TakeWhile<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        if self.done {
            return Option::None;
        }
        dec opt = self.iter.next();
        match opt {
            Option::Some(x) -> {
                dec p_ptr = self.pred;
                if p_ptr(x) {
                    return Option::Some(x);
                } else {
                    self.done = true;
                    return Option::None;
                }
            },
            Option::None -> {
                self.done = true;
                return Option::None;
            },
        }
    }
}

export fn iter_take_while<I: Iterator<Item>, Item>(iter: I, pred: fn(Item) -> bool) -> TakeWhile<I, Item> {
    return TakeWhile<I, Item> {
        iter: iter,
        pred: pred,
        done: false,
    };
}

export struct Peekable<I, Item> {
    private iter: I,
    private peeked: Option<Item>,
    private has_peeked: bool,
};

impl<I: Iterator<Item>, Item> Iterator<Item> for Peekable<I, Item> {
    fn next(self: &rw Self) -> Option<Item> {
        if self.has_peeked {
            self.has_peeked = false;
            dec val = self.peeked;
            self.peeked = Option::None;
            return val;
        }
        return self.iter.next();
    }
}

impl<I: Iterator<Item>, Item: Clone> Peekable<I, Item> {
    export fn peek(self: &rw Self) -> Option<Item> {
        if self.has_peeked == false {
            dec opt = self.iter.next();
            self.peeked = opt;
            self.has_peeked = true;
        }
        match self.peeked {
            Option::Some(val) -> {
                dec copy_val = val.clone();
                self.peeked = Option::Some(val);
                return Option::Some(copy_val);
            },
            Option::None -> {
                self.peeked = Option::None;
                return Option::None;
            },
        }
    }
}

impl<I: Iterator<Item>, Item> Peekable<I, Item> {
    export fn has_next(self: &rw Self) -> bool {
        if self.has_peeked == false {
            dec opt = self.iter.next();
            self.peeked = opt;
            self.has_peeked = true;
        }
        return self.peeked.is_some();
    }
}

export fn iter_peekable<I: Iterator<Item>, Item>(iter: I) -> Peekable<I, Item> {
    return Peekable<I, Item> {
        iter: iter,
        peeked: Option::None,
        has_peeked: false,
    };
}


// =========================================================================
// Generic Range & RangeInclusive Iterators across 10 Integer Types
// =========================================================================

export struct Range<T> {
    export start: T,
    export end: T,
};

export struct RangeInclusive<T> {
    export start: T,
    export end: T,
    export done: bool,
};

export fn range<T>(start: T, end: T) -> Range<T> {
    return Range<T> {
        start: start,
        end: end,
    };
}

export fn range_inclusive<T>(start: T, end: T) -> RangeInclusive<T> {
    return RangeInclusive<T> {
        start: start,
        end: end,
        done: false,
    };
}

// Iterator implementations for Range across 10 Integer Types
impl Iterator<u8> for Range<u8> { fn next(self: &rw Self) -> Option<u8> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as u8); return Option::Some(val); } }
impl Iterator<u16> for Range<u16> { fn next(self: &rw Self) -> Option<u16> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as u16); return Option::Some(val); } }
impl Iterator<u32> for Range<u32> { fn next(self: &rw Self) -> Option<u32> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as u32); return Option::Some(val); } }
impl Iterator<u64> for Range<u64> { fn next(self: &rw Self) -> Option<u64> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as u64); return Option::Some(val); } }
impl Iterator<usize> for Range<usize> { fn next(self: &rw Self) -> Option<usize> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as usize); return Option::Some(val); } }
impl Iterator<i8> for Range<i8> { fn next(self: &rw Self) -> Option<i8> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as i8); return Option::Some(val); } }
impl Iterator<i16> for Range<i16> { fn next(self: &rw Self) -> Option<i16> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as i16); return Option::Some(val); } }
impl Iterator<i32> for Range<i32> { fn next(self: &rw Self) -> Option<i32> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as i32); return Option::Some(val); } }
impl Iterator<i64> for Range<i64> { fn next(self: &rw Self) -> Option<i64> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as i64); return Option::Some(val); } }
impl Iterator<isize> for Range<isize> { fn next(self: &rw Self) -> Option<isize> { if self.start >= self.end { return Option::None; } dec val = self.start; self.start = self.start + (1 as isize); return Option::Some(val); } }

// Iterator implementations for RangeInclusive across 10 Integer Types (with done flag to avoid MAX overflow)
impl Iterator<u8> for RangeInclusive<u8> { fn next(self: &rw Self) -> Option<u8> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as u8); } return Option::Some(val); } }
impl Iterator<u16> for RangeInclusive<u16> { fn next(self: &rw Self) -> Option<u16> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as u16); } return Option::Some(val); } }
impl Iterator<u32> for RangeInclusive<u32> { fn next(self: &rw Self) -> Option<u32> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as u32); } return Option::Some(val); } }
impl Iterator<u64> for RangeInclusive<u64> { fn next(self: &rw Self) -> Option<u64> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as u64); } return Option::Some(val); } }
impl Iterator<usize> for RangeInclusive<usize> { fn next(self: &rw Self) -> Option<usize> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as usize); } return Option::Some(val); } }
impl Iterator<i8> for RangeInclusive<i8> { fn next(self: &rw Self) -> Option<i8> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as i8); } return Option::Some(val); } }
impl Iterator<i16> for RangeInclusive<i16> { fn next(self: &rw Self) -> Option<i16> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as i16); } return Option::Some(val); } }
impl Iterator<i32> for RangeInclusive<i32> { fn next(self: &rw Self) -> Option<i32> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as i32); } return Option::Some(val); } }
impl Iterator<i64> for RangeInclusive<i64> { fn next(self: &rw Self) -> Option<i64> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as i64); } return Option::Some(val); } }
impl Iterator<isize> for RangeInclusive<isize> { fn next(self: &rw Self) -> Option<isize> { if self.done || self.start > self.end { return Option::None; } dec val = self.start; if self.start == self.end { self.done = true; } else { self.start = self.start + (1 as isize); } return Option::Some(val); } }

