import <__lang_option>;
import <__lang_iterator>;
import <ptr>;
import <cmp>;
import <result>;
import <mem>;
import <clone>;
import <copy>;
import <core/panic>;

module slice {
    // SliceIter: Borrowed iterator over slice
    // ITER-4: A borrowed collection iterator MUST NOT transfer ownership
    // ITER-9: SliceIter<T>::Item is &T
    // ITER-10: SliceIter does not move/drop backing elements
    // =========================================================================
    export struct SliceIter<T> {
        private ptr: *T,
        private end: *T,
    };
    
    impl<T> SliceIter<T> {
        // Shared borrow iteration - returns reference to backing element
        export fn next_ref(self: &rw Self) -> Option<&T> life_from(self) {
            if (self.ptr as u64) >= (self.end as u64) {
                return Option::None;
            }
            unsafe {
                dec item_ptr = self.ptr;
                self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *T;
                return Option::Some(&*item_ptr);
            }
        }
    }
    
    // ITER-9: Item is &T (borrowed reference, not owned value)
    impl<T> Iterator<&T> for SliceIter<T> {
        fn next(self: &rw Self) -> Option<&T> {
            if (self.ptr as u64) >= (self.end as u64) {
                return Option::None;
            }
            unsafe {
                dec item_ptr = self.ptr;
                self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *T;
                return Option::Some(&*item_ptr);
            }
        }
    }
    
    export struct SliceIterMut<T> {
        private ptr: *rw T,
        private end: *rw T,
    };
    
    impl<T> SliceIterMut<T> {
        export fn next_mut(self: &rw Self) -> Option<&rw T> life_from(self) {
            if (self.ptr as u64) >= (self.end as u64) {
                return Option::None;
            }
            unsafe {
                dec item_ptr = self.ptr;
                self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *rw T;
                return Option::Some(&rw *item_ptr);
            }
        }
    }
    
    impl<T> Iterator<&rw T> for SliceIterMut<T> {
        fn next(self: &rw Self) -> Option<&rw T> {
            if (self.ptr as u64) >= (self.end as u64) {
                return Option::None;
            }
            unsafe {
                dec item_ptr = self.ptr;
                self.ptr = (self.ptr as u64 + (sizeof(T) as u64)) as *rw T;
                return Option::Some(&rw *item_ptr);
            }
        }
    }
    
    export fn slice_iter<T>(s: &[T]) -> SliceIter<T> life_from(s) {
        dec end_ptr = (s.data as u64 + (s.len as u64 * (sizeof(T) as u64))) as *T;
        return SliceIter<T> {
            ptr: s.data as *T,
            end: end_ptr,
        };
    }
    
    export fn slice_iter_mut<T>(s: &rw [T]) -> SliceIterMut<T> life_from(s) {
        dec end_ptr = (s.data as u64 + (s.len as u64 * (sizeof(T) as u64))) as *rw T;
        return SliceIterMut<T> {
            ptr: s.data as *rw T,
            end: end_ptr,
        };
    }

    export fn contains<T: Eq>(s: &[T], item: &T) -> bool {
        dec len = s.len as u64;
        dec rw i: u64 = 0 as u64;
        while i < len {
            dec elem = &s[i];
            if elem.eq(item) {
                return true;
            }
            i = i + (1 as u64);
        }
        return false;
    }

    export fn position<T>(s: &[T], predicate: fn(&T) -> bool) -> Option<u64> {
        dec len = s.len as u64;
        dec rw i: u64 = 0 as u64;
        while i < len {
            if predicate(&s[i]) {
                return Option::Some(i);
            }
            i = i + (1 as u64);
        }
        return Option::None;
    }

    export fn binary_search<T: Ord>(s: &[T], item: &T) -> Result<u64, u64> {
        dec rw low: u64 = 0 as u64;
        dec rw high: u64 = s.len as u64;
        while low < high {
            dec mid = low + ((high - low) / (2 as u64));
            dec c = s[mid].cmp(item);
            if c < 0 {
                low = mid + (1 as u64);
            } else if c > 0 {
                high = mid;
            } else {
                return Result::Ok(mid);
            }
        }
        return Result::Err(low);
    }

    export fn reverse<T>(s: &rw [T]) {
        dec len = s.len as u64;
        if len <= (1 as u64) {
            return;
        }
        dec rw left: u64 = 0 as u64;
        dec rw right: u64 = len;
        while left + (1 as u64) < right {
            right = right - (1 as u64);
            unsafe {
                dec p_left = ptr::add_mut<T>(s.data, left);
                dec p_right = ptr::add_mut<T>(s.data, right);
                dec tmp = ptr::read<T>(p_left as *T);
                ptr::write<T>(p_left, ptr::read<T>(p_right as *T));
                ptr::write<T>(p_right, tmp);
            }
            left = left + (1 as u64);
        }
    }

    fn slice_elem_swap<T>(s: &rw [T], i: u64, j: u64) {
        if i == j {
            return;
        }
        unsafe {
            dec p1 = ptr::add_mut<T>(s.data, i);
            dec p2 = ptr::add_mut<T>(s.data, j);
            dec tmp = ptr::read<T>(p1 as *T);
            ptr::write<T>(p1, ptr::read<T>(p2 as *T));
            ptr::write<T>(p2, tmp);
        }
    }

    fn floor_log2(n: u64) -> u64 {
        dec rw val = n;
        dec rw log: u64 = 0 as u64;
        while val > (1 as u64) {
            val = val / (2 as u64);
            log = log + (1 as u64); 
        }
        return log;
    }

    // --- Introsort implementation using compare function pointer ---

    fn insertion_sort_range_by<T>(s: &rw [T], lo: u64, hi: u64, compare: fn(&T, &T) -> i32) {
        if hi <= lo + (1 as u64) {
            return;
        }
        dec rw i: u64 = lo + (1 as u64);
        while i < hi {
            dec rw j: u64 = i;
            while j > lo {
                dec j_prev = j - (1 as u64);
                dec c = compare(&s[j], &s[j_prev]);
                if c < 0 {
                    slice_elem_swap<T>(s, j, j_prev);
                    j = j_prev;
                } else {
                    break;
                }
            }
            i = i + (1 as u64);
        }
    }

    fn sift_down_by<T>(s: &rw [T], lo: u64, root: u64, count: u64, compare: fn(&T, &T) -> i32) {
        dec rw curr_root = root;
        while (curr_root * (2 as u64)) + (1 as u64) < count {
            dec rw child = (curr_root * (2 as u64)) + (1 as u64);
            if child + (1 as u64) < count {
                if compare(&s[lo + child], &s[lo + child + (1 as u64)]) < 0 {
                    child = child + (1 as u64);
                }
            }
            if compare(&s[lo + curr_root], &s[lo + child]) < 0 {
                slice_elem_swap<T>(s, lo + curr_root, lo + child);
                curr_root = child;
            } else {
                return;
            }
        }
    }

    fn heap_sort_range_by<T>(s: &rw [T], lo: u64, hi: u64, compare: fn(&T, &T) -> i32) {
        dec count = hi - lo;
        if count <= (1 as u64) {
            return;
        }
        dec rw i: u64 = count / (2 as u64);
        while i > (0 as u64) {
            i = i - (1 as u64);
            sift_down_by<T>(s, lo, i, count, compare);
        }
        dec rw end: u64 = count;
        while end > (1 as u64) {
            end = end - (1 as u64);
            slice_elem_swap<T>(s, lo, lo + end);
            sift_down_by<T>(s, lo, 0 as u64, end, compare);
        }
    }

    fn partition_by<T>(s: &rw [T], lo: u64, hi: u64, compare: fn(&T, &T) -> i32) -> u64 {
        dec mid = lo + ((hi - lo) / (2 as u64));
        dec hi_minus_1 = hi - (1 as u64);
        if compare(&s[mid], &s[lo]) < 0 {
            slice_elem_swap<T>(s, lo, mid);
        }
        if compare(&s[hi_minus_1], &s[mid]) < 0 {
            slice_elem_swap<T>(s, mid, hi_minus_1);
            if compare(&s[mid], &s[lo]) < 0 {
                slice_elem_swap<T>(s, lo, mid);
            }
        }
        slice_elem_swap<T>(s, mid, hi_minus_1);

        dec rw i: u64 = lo;
        dec rw j: u64 = lo;
        while j < hi_minus_1 {
            if compare(&s[j], &s[hi_minus_1]) < 0 {
                slice_elem_swap<T>(s, i, j);
                i = i + (1 as u64);
            }
            j = j + (1 as u64);
        }
        slice_elem_swap<T>(s, i, hi_minus_1);
        return i;
    }

    fn introsort_loop_by<T>(s: &rw [T], lo: u64, hi: u64, max_depth: u64, compare: fn(&T, &T) -> i32) {
        dec rw curr_lo = lo;
        dec rw curr_hi = hi;
        dec rw depth = max_depth;
        while (curr_hi - curr_lo) > (16 as u64) {
            if depth == (0 as u64) {
                heap_sort_range_by<T>(s, curr_lo, curr_hi, compare);
                return;
            }
            depth = depth - (1 as u64);
            dec p = partition_by<T>(s, curr_lo, curr_hi, compare);
            if p + (1 as u64) < curr_hi {
                introsort_loop_by<T>(s, p + (1 as u64), curr_hi, depth, compare);
            }
            curr_hi = p;
        }
        insertion_sort_range_by<T>(s, curr_lo, curr_hi, compare);
    }

    export fn sort_by<T>(s: &rw [T], compare: fn(&T, &T) -> i32) {
        dec len = s.len as u64;
        if len <= (1 as u64) {
            return;
        }
        dec max_depth = floor_log2(len) * (2 as u64);
        introsort_loop_by<T>(s, 0 as u64, len, max_depth, compare);
    }

    // --- Introsort implementation using Ord::cmp directly ---

    fn insertion_sort_range_ord<T: Ord>(s: &rw [T], lo: u64, hi: u64) {
        if hi <= lo + (1 as u64) {
            return;
        }
        dec rw i: u64 = lo + (1 as u64);
        while i < hi {
            dec rw j: u64 = i;
            while j > lo {
                dec j_prev = j - (1 as u64);
                dec c = s[j].cmp(&s[j_prev]);
                if c < 0 {
                    slice_elem_swap<T>(s, j, j_prev);
                    j = j_prev;
                } else {
                    break;
                }
            }
            i = i + (1 as u64);
        }
    }

    fn sift_down_ord<T: Ord>(s: &rw [T], lo: u64, root: u64, count: u64) {
        dec rw curr_root = root;
        while (curr_root * (2 as u64)) + (1 as u64) < count {
            dec rw child = (curr_root * (2 as u64)) + (1 as u64);
            if child + (1 as u64) < count {
                if s[lo + child].cmp(&s[lo + child + (1 as u64)]) < 0 {
                    child = child + (1 as u64);
                }
            }
            if s[lo + curr_root].cmp(&s[lo + child]) < 0 {
                slice_elem_swap<T>(s, lo + curr_root, lo + child);
                curr_root = child;
            } else {
                return;
            }
        }
    }

    fn heap_sort_range_ord<T: Ord>(s: &rw [T], lo: u64, hi: u64) {
        dec count = hi - lo;
        if count <= (1 as u64) {
            return;
        }
        dec rw i: u64 = count / (2 as u64);
        while i > (0 as u64) {
            i = i - (1 as u64);
            sift_down_ord<T>(s, lo, i, count);
        }
        dec rw end: u64 = count;
        while end > (1 as u64) {
            end = end - (1 as u64);
            slice_elem_swap<T>(s, lo, lo + end);
            sift_down_ord<T>(s, lo, 0 as u64, end);
        }
    }

    fn partition_ord<T: Ord>(s: &rw [T], lo: u64, hi: u64) -> u64 {
        dec mid = lo + ((hi - lo) / (2 as u64));
        dec hi_minus_1 = hi - (1 as u64);
        if s[mid].cmp(&s[lo]) < 0 {
            slice_elem_swap<T>(s, lo, mid);
        }
        if s[hi_minus_1].cmp(&s[mid]) < 0 {
            slice_elem_swap<T>(s, mid, hi_minus_1);
            if s[mid].cmp(&s[lo]) < 0 {
                slice_elem_swap<T>(s, lo, mid);
            }
        }
        slice_elem_swap<T>(s, mid, hi_minus_1);

        dec rw i: u64 = lo;
        dec rw j: u64 = lo;
        while j < hi_minus_1 {
            if s[j].cmp(&s[hi_minus_1]) < 0 {
                slice_elem_swap<T>(s, i, j);
                i = i + (1 as u64);
            }
            j = j + (1 as u64);
        }
        slice_elem_swap<T>(s, i, hi_minus_1);
        return i;
    }

    fn introsort_loop_ord<T: Ord>(s: &rw [T], lo: u64, hi: u64, max_depth: u64) {
        dec rw curr_lo = lo;
        dec rw curr_hi = hi;
        dec rw depth = max_depth;
        while (curr_hi - curr_lo) > (16 as u64) {
            if depth == (0 as u64) {
                heap_sort_range_ord<T>(s, curr_lo, curr_hi);
                return;
            }
            depth = depth - (1 as u64);
            dec p = partition_ord<T>(s, curr_lo, curr_hi);
            if p + (1 as u64) < curr_hi {
                introsort_loop_ord<T>(s, p + (1 as u64), curr_hi, depth);
            }
            curr_hi = p;
        }
        insertion_sort_range_ord<T>(s, curr_lo, curr_hi);
    }

    export fn sort<T: Ord>(s: &rw [T]) {
        dec len = s.len as u64;
        if len <= (1 as u64) {
            return;
        }
        dec max_depth = floor_log2(len) * (2 as u64);
        introsort_loop_ord<T>(s, 0 as u64, len, max_depth);
    }
    export fn get<T>(s: &[T], index: u64) -> Option<&T> life_from(s) {
        if index >= (s.len as u64) {
            return Option::None;
        }
        unsafe {
            dec p = ptr::add<T>(s.data as *T, index);
            return Option::Some(&*p);
        }
    }

    export fn get_mut<T>(s: &rw [T], index: u64) -> Option<&rw T> life_from(s) {
        if index >= (s.len as u64) {
            return Option::None;
        }
        unsafe {
            dec p = ptr::add_mut<T>(s.data as *rw T, index);
            return Option::Some(&rw *p);
        }
    }

    export fn split_at<T>(s: &[T], mid: u64) -> (&[T], &[T]) life_from(s) {
        dec total_len = s.len as u64;
        if mid > total_len {
            __luna_panic_default();
        }
        unsafe {
            dec raw_ptr = s.data as *T;
            dec left = mem::slice_from_raw_parts<T>(raw_ptr, mid);
            dec right_ptr = ptr::add<T>(raw_ptr, mid);
            dec right = mem::slice_from_raw_parts<T>(right_ptr, total_len - mid);
            return (left, right);
        }
    }

    export fn split_at_mut<T>(s: &rw [T], mid: u64) -> (&rw [T], &rw [T]) life_from(s) {
        dec total_len = s.len as u64;
        if mid > total_len {
            __luna_panic_default();
        }
        unsafe {
            dec raw_ptr = s.data as *rw T;
            dec left = mem::slice_from_raw_parts_mut<T>(raw_ptr, mid);
            dec right_ptr = ptr::add_mut<T>(raw_ptr, mid);
            dec right = mem::slice_from_raw_parts_mut<T>(right_ptr, total_len - mid);
            return (left, right);
        }
    }

    export fn copy_from_slice<T: Copy>(dst: &rw [T], src: &[T]) {
        if (dst.len as u64) != (src.len as u64) {
            __luna_panic_default();
        }
        dec len = dst.len as u64;
        dec rw i: u64 = 0 as u64;
        while i < len {
            dst[i] = src[i];
            i = i + (1 as u64);
        }
    }

    export fn fill<T: Clone>(s: &rw [T], value: T) {
        dec len = s.len as u64;
        dec rw i: u64 = 0 as u64;
        while i < len {
            s[i] = value.clone();
            i = i + (1 as u64);
        }
    }
}

export fn slice_iter<T>(s: &[T]) -> slice::SliceIter<T> life_from(s) {
    return slice::slice_iter<T>(s);
}

export fn slice_iter_mut<T>(s: &rw [T]) -> slice::SliceIterMut<T> life_from(s) {
    return slice::slice_iter_mut<T>(s);
}

export fn slice_contains<T: Eq>(s: &[T], item: &T) -> bool {
    return slice::contains<T>(s, item);
}

export fn slice_position<T>(s: &[T], predicate: fn(&T) -> bool) -> Option<u64> {
    return slice::position<T>(s, predicate);
}

export fn slice_binary_search<T: Ord>(s: &[T], item: &T) -> Result<u64, u64> {
    return slice::binary_search<T>(s, item);
}

export fn slice_reverse<T>(s: &rw [T]) {
    slice::reverse<T>(s);
}

export fn slice_sort<T: Ord>(s: &rw [T]) {
    slice::sort<T>(s);
}

export fn slice_sort_by<T>(s: &rw [T], compare: fn(&T, &T) -> i32) {
    slice::sort_by<T>(s, compare);
}

export fn slice_get<T>(s: &[T], index: u64) -> Option<&T> life_from(s) {
    return slice::get<T>(s, index);
}

export fn slice_get_mut<T>(s: &rw [T], index: u64) -> Option<&rw T> life_from(s) {
    return slice::get_mut<T>(s, index);
}

export fn slice_split_at<T>(s: &[T], mid: u64) -> (&[T], &[T]) life_from(s) {
    return slice::split_at<T>(s, mid);
}

export fn slice_split_at_mut<T>(s: &rw [T], mid: u64) -> (&rw [T], &rw [T]) life_from(s) {
    return slice::split_at_mut<T>(s, mid);
}

export fn slice_copy_from_slice<T: Copy>(dst: &rw [T], src: &[T]) {
    slice::copy_from_slice<T>(dst, src);
}

export fn slice_fill<T: Clone>(s: &rw [T], value: T) {
    slice::fill<T>(s, value);
}

export type SliceIter<T> = slice::SliceIter<T>;
export type SliceIterMut<T> = slice::SliceIterMut<T>;
