    if b == ((0 as i16) - (1 as i16)) && a == min_val { return Option::None; }
    if a > (0 as i16) {
        if b > (0 as i16) && a > (max_val / b) { return Option::None; }
        if b < (0 as i16) && b < (min_val / a) { return Option::None; }
