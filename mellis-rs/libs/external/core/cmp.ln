export fn checked_mul_i64(a: i64, b: i64) -> Option<i64> {
    dec max_val = 9223372036854775807 as i64;
    dec min_val = (0 as i64) - (9223372036854775807 as i64) - (1 as i64);
    if a == (0 as i64) || b == (0 as i64) { return Option::Some(0 as i64); }
    if a == ((0 as i64) - (1 as i64)) && b == min_val { return Option::None; }
    if b == ((0 as i64) - (1 as i64)) && a == min_val { return Option::None; }
    if a > (0 as i64) {
        if b > (0 as i64) && a > (max_val / b) { return Option::None; }
        if b < (0 as i64) && b < (min_val / a) { return Option::None; }
    } else {
        if b > (0 as i64) && a < (min_val / b) { return Option::None; }
        if b < (0 as i64) && b < (max_val / a) { return Option::None; }
    }
