export fn checked_add_i32(a: i32, b: i32) -> Option<i32> {
    dec max_val = 2147483647 as i32;
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if b > 0 && a > (max_val - b) { return Option::None; }
    if b < 0 && a < (min_val - b) { return Option::None; }
    return Option::Some(a + b);
}
export fn checked_sub_i32(a: i32, b: i32) -> Option<i32> {
    dec max_val = 2147483647 as i32;
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if b > 0 && a < (min_val + b) { return Option::None; }
    if b < 0 && a > (max_val + b) { return Option::None; }
    return Option::Some(a - b);
}
export fn checked_mul_i32(a: i32, b: i32) -> Option<i32> {
    dec max_val = 2147483647 as i32;
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if a == 0 || b == 0 { return Option::Some(0); }
    if a == (0 - 1) && b == min_val { return Option::None; }
    if b == (0 - 1) && a == min_val { return Option::None; }
    if a > 0 {
        if b > 0 && a > (max_val / b) { return Option::None; }
        if b < 0 && b < (min_val / a) { return Option::None; }
    } else {
        if b > 0 && a < (min_val / b) { return Option::None; }
        if b < 0 && b < (max_val / a) { return Option::None; }
    }
    return Option::Some(a * b);
}
export fn checked_div_i32(a: i32, b: i32) -> Option<i32> {
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if b == 0 { return Option::None; }
    if a == min_val && b == (0 - 1) { return Option::None; }
    return Option::Some(a / b);
}
export fn saturating_add_i32(a: i32, b: i32) -> i32 {
    dec max_val = 2147483647 as i32;
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if b > 0 && a > (max_val - b) { return max_val; }
    if b < 0 && a < (min_val - b) { return min_val; }
    return a + b;
}
export fn saturating_sub_i32(a: i32, b: i32) -> i32 {
    dec max_val = 2147483647 as i32;
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if b > 0 && a < (min_val + b) { return min_val; }
    if b < 0 && a > (max_val + b) { return max_val; }
    return a - b;
}
export fn saturating_mul_i32(a: i32, b: i32) -> i32 {
    dec max_val = 2147483647 as i32;
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    dec res = checked_mul_i32(a, b);
    if res.is_some() {
        return res.unwrap();
    }
    if (a > 0 && b > 0) || (a < 0 && b < 0) {
        return max_val;
    }
    return min_val;
}
export fn abs_i32(val: i32) -> i32 {
    if val < 0 { return 0 - val; }
    return val;
}
export fn checked_abs_i32(val: i32) -> Option<i32> {
    dec min_val = (0 as i32) - (2147483647 as i32) - (1 as i32);
    if val == min_val { return Option::None; }
    return Option::Some(abs_i32(val));
}

export fn checked_add_i64(a: i64, b: i64) -> Option<i64> {
    dec max_val = 9223372036854775807 as i64;
