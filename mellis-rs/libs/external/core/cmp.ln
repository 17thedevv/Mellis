// --- Signed Integer Utilities ---

export fn checked_add_i8(a: i8, b: i8) -> Option<i8> {
    dec max_val = 127 as i8;
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if b > (0 as i8) && a > (max_val - b) { return Option::None; }
    if b < (0 as i8) && a < (min_val - b) { return Option::None; }
    return Option::Some(a + b);
}
export fn checked_sub_i8(a: i8, b: i8) -> Option<i8> {
    dec max_val = 127 as i8;
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if b > (0 as i8) && a < (min_val + b) { return Option::None; }
    if b < (0 as i8) && a > (max_val + b) { return Option::None; }
    return Option::Some(a - b);
}
export fn checked_mul_i8(a: i8, b: i8) -> Option<i8> {
    dec max_val = 127 as i8;
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if a == (0 as i8) || b == (0 as i8) { return Option::Some(0 as i8); }
    if a == ((0 as i8) - (1 as i8)) && b == min_val { return Option::None; }
    if b == ((0 as i8) - (1 as i8)) && a == min_val { return Option::None; }
    if a > (0 as i8) {
        if b > (0 as i8) && a > (max_val / b) { return Option::None; }
        if b < (0 as i8) && b < (min_val / a) { return Option::None; }
    } else {
        if b > (0 as i8) && a < (min_val / b) { return Option::None; }
        if b < (0 as i8) && b < (max_val / a) { return Option::None; }
    }
    return Option::Some(a * b);
}
export fn checked_div_i8(a: i8, b: i8) -> Option<i8> {
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if b == (0 as i8) { return Option::None; }
    if a == min_val && b == ((0 as i8) - (1 as i8)) { return Option::None; }
    return Option::Some(a / b);
}
export fn saturating_add_i8(a: i8, b: i8) -> i8 {
    dec max_val = 127 as i8;
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if b > (0 as i8) && a > (max_val - b) { return max_val; }
    if b < (0 as i8) && a < (min_val - b) { return min_val; }
    return a + b;
}
export fn saturating_sub_i8(a: i8, b: i8) -> i8 {
    dec max_val = 127 as i8;
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if b > (0 as i8) && a < (min_val + b) { return min_val; }
    if b < (0 as i8) && a > (max_val + b) { return max_val; }
    return a - b;
}
export fn saturating_mul_i8(a: i8, b: i8) -> i8 {
    dec max_val = 127 as i8;
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    dec res = checked_mul_i8(a, b);
    if res.is_some() {
        return res.unwrap();
    }
    if (a > (0 as i8) && b > (0 as i8)) || (a < (0 as i8) && b < (0 as i8)) {
        return max_val;
    }
    return min_val;
}
export fn abs_i8(val: i8) -> i8 {
    if val < (0 as i8) { return (0 as i8) - val; }
    return val;
}
export fn checked_abs_i8(val: i8) -> Option<i8> {
    dec min_val = (0 as i8) - (127 as i8) - (1 as i8);
    if val == min_val { return Option::None; }
    return Option::Some(abs_i8(val));
}

