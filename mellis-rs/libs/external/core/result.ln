import <core/panic>;
import <__lang_option>;

export enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    export fn is_ok(self: &Self) -> bool {
        match *self {
            Result::Ok(_) -> true,
            Result::Err(_) -> false,
        }
    }

    export fn is_err(self: &Self) -> bool {
        match *self {
            Result::Ok(_) -> false,
            Result::Err(_) -> true,
        }
    }

    export fn ok(self: Self) -> Option<T> {
        return match self {
            Result::Ok(val) -> Option::Some(val),
            Result::Err(e) -> Option::None,
        };
    }

    export fn err(self: Self) -> Option<E> {
        return match self {
            Result::Ok(val) -> Option::None,
            Result::Err(e) -> Option::Some(e),
        };
    }

    export fn unwrap(self: Self) -> T {
        match self {
            Result::Ok(val) -> val,
            Result::Err(_) -> __luna_panic_default(),
        }
    }

    export fn expect(self: Self, _msg: str) -> T {
        match self {
            Result::Ok(val) -> val,
            Result::Err(_) -> __luna_panic_default(),
        }
    }

    export fn unwrap_err(self: Self) -> E {
        match self {
            Result::Err(e) -> e,
            Result::Ok(_) -> __luna_panic_default(),
        }
    }

    export fn unwrap_or(self: Self, default: T) -> T {
        match self {
            Result::Ok(val) -> val,
            Result::Err(_) -> default,
        }
    }

    export fn map<U>(self: Self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(val) -> Result::Ok(f(val)),
            Result::Err(e) -> Result::Err(e),
        }
    }

    export fn map_err<F>(self: Self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(val) -> Result::Ok(val),
            Result::Err(e) -> Result::Err(f(e)),
        }
    }

    export fn and_then<U>(self: Self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(val) -> f(val),
            Result::Err(e) -> Result::Err(e),
        }
    }

    export fn unwrap_or_else(self: Self, f: fn(E) -> T) -> T {
        match self {
            Result::Ok(val) -> val,
            Result::Err(e) -> f(e),
        }
    }

    export fn or_else<F>(self: Self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Result::Ok(val) -> Result::Ok(val),
            Result::Err(e) -> f(e),
        }
    }
}

impl<T, E> Result<Result<T, E>, E> {
    export fn flatten(self: Self) -> Result<T, E> {
        match self {
            Result::Ok(inner) -> inner,
            Result::Err(e) -> Result::Err(e),
        }
    }
}

export fn result_flatten<T, E>(res: Result<Result<T, E>, E>) -> Result<T, E> {
    match res {
        Result::Ok(inner) -> inner,
        Result::Err(e) -> Result::Err(e),
    }
}

impl<T, E> Result<Option<T>, E> {
    export fn transpose(self: Self) -> Option<Result<T, E>> {
        match self {
            Result::Ok(opt) -> match opt {
                Option::Some(val) -> Option::Some(Result::Ok(val)),
                Option::None -> Option::None,
            },
            Result::Err(e) -> Option::Some(Result::Err(e)),
        }
    }
}

export fn result_transpose<T, E>(res: Result<Option<T>, E>) -> Option<Result<T, E>> {
    match res {
        Result::Ok(opt) -> match opt {
            Option::Some(val) -> Option::Some(Result::Ok(val)),
            Option::None -> Option::None,
        },
        Result::Err(e) -> Option::Some(Result::Err(e)),
    }
}

export fn option_transpose<T, E>(opt: Option<Result<T, E>>) -> Result<Option<T>, E> {
    match opt {
        Option::Some(res) -> match res {
            Result::Ok(val) -> Result::Ok(Option::Some(val)),
            Result::Err(e) -> Result::Err(e),
        },
        Option::None -> Result::Ok(Option::None),
    }
}

export trait OptionExt<T> {
    fn ok_or<E>(self: Self, err: E) -> Result<T, E>;
}

impl<T> OptionExt<T> for Option<T> {
    fn ok_or<E>(self: Self, err: E) -> Result<T, E> {
        return match self {
            Option::Some(val) -> Result::Ok(val),
            Option::None -> Result::Err(err),
        };
    }
}
