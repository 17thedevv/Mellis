import <core/panic>;

#[lang("option")]
export enum Option<T> {
    #[lang("some")]
    Some(T),
    #[lang("none")]
    None,
}

impl<T> Option<T> {
    export fn is_some(self: &Self) -> bool {
        match *self {
            Option::Some(_) -> true,
            Option::None -> false,
        }
    }

    export fn is_none(self: &Self) -> bool {
        match *self {
            Option::Some(_) -> false,
            Option::None -> true,
        }
    }

    export fn ok(self: Self) -> Option<T> {
        return self;
    }

    export fn unwrap(self: Self) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> __luna_panic_default(),
        }
    }

    export fn expect(self: Self, _msg: str) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> __luna_panic_default(),
        }
    }

    export fn unwrap_or(self: Self, default: T) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> default,
        }
    }

    export fn map<U>(self: Self, f: fn(T) -> U) -> Option<U> {
        match self {
            Option::Some(val) -> Option::Some(f(val)),
            Option::None -> Option::None,
        }
    }

    export fn and_then<U>(self: Self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Option::Some(val) -> f(val),
            Option::None -> Option::None,
        }
    }

    export fn unwrap_or_else(self: Self, f: fn() -> T) -> T {
        match self {
            Option::Some(val) -> val,
            Option::None -> f(),
        }
    }

    export fn or_else(self: Self, f: fn() -> Option<T>) -> Option<T> {
        match self {
            Option::Some(val) -> Option::Some(val),
            Option::None -> f(),
        }
    }
}

impl<T> Option<Option<T>> {
    export fn flatten(self: Self) -> Option<T> {
        match self {
            Option::Some(inner) -> inner,
            Option::None -> Option::None,
        }
    }
}

export fn option_flatten<T>(opt: Option<Option<T>>) -> Option<T> {
    match opt {
        Option::Some(inner) -> inner,
        Option::None -> Option::None,
    }
}

