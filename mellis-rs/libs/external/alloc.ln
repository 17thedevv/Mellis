import <core>;

export extern fn __mellis_alloc(size: u64, align: u64) -> *rw u8;
export extern fn __mellis_dealloc(ptr: *rw u8, size: u64, align: u64);
export extern fn __mellis_realloc(ptr: *rw u8, old_size: u64, old_align: u64, new_size: u64) -> *rw u8;

module std {
    export struct Box<T> {
        private ptr: *rw T,
    }

    export fn box_new<T>(val: T) -> Box<T> {
        dec size = mem::size_of<T>();
        dec align = mem::align_of<T>();
        dec raw = __mellis_alloc(size, align) as *rw T;
        unsafe {
            ptr::write<T>(raw, val);
        }
        return Box<T> {
            ptr: raw,
        };
    }

    export fn box_into_inner<T>(b: Box<T>) -> T {
        dec rw boxed = b;
        dec raw = boxed.ptr;
        boxed.ptr = 0 as u64 as *rw T;
        unsafe {
            dec val = ptr::read<T>(raw as *T);
            __mellis_dealloc(raw as *rw u8, mem::size_of<T>(), mem::align_of<T>());
            return val;
        }
    }

    impl<T> Box<T> {
        export fn as_ref(self: &Self) -> &T life_from(self) {
            unsafe {
                return &*(self.ptr as *T);
            }
        }

        export fn as_mut(self: &rw Self) -> &rw T life_from(self) {
            unsafe {
                return &rw *self.ptr;
            }
        }
    }

    impl<T> Drop for Box<T> {
        fn drop(self: &rw Self) {
            if (self.ptr as u64) != (0 as u64) {
                unsafe {
                    ptr::drop_in_place<T>(self.ptr);
                    __mellis_dealloc(self.ptr as *rw u8, mem::size_of<T>(), mem::align_of<T>());
                }
                self.ptr = 0 as u64 as *rw T;
            }
        }
    }
}

export type Box<T> = std::Box<T>;

export struct Vec<T> {
    private ptr: *rw T,
    private len: u64,
    private cap: u64,
}

export fn vec_new<T>() -> Vec<T> {
    return Vec<T> {
        ptr: 0 as u64 as *rw T,
        len: 0 as u64,
        cap: 0 as u64,
    };
}

export fn vec_with_capacity<T>(capacity: u64) -> Vec<T> {
    if capacity == (0 as u64) {
        return vec_new<T>();
    }
    dec size = capacity * (mem::size_of<T>() as u64);
    dec align = mem::align_of<T>() as u64;
    dec ptr = __mellis_alloc(size, align) as u64 as *rw T;
    return Vec<T> {
        ptr: ptr,
        len: 0 as u64,
        cap: capacity,
    };
}

export type VecIter<T> = SliceIter<T>;
export type VecIterMut<T> = SliceIterMut<T>;

// =========================================================================
// VecIntoIter: Owned, consuming iterator over Vec<T>
// =========================================================================
export struct VecIntoIter<T> {
    private ptr: *rw T,
    private len: u64,
    private cap: u64,
    private index: u64,
}

impl<T> Iterator<T> for VecIntoIter<T> {
    fn next(self: &rw Self) -> Option<T> {
        if self.index >= self.len {
            return Option::None;
        }
        unsafe {
            dec item_ptr = ptr::add_mut<T>(self.ptr, self.index);
            dec val = ptr::read<T>(item_ptr as *T);
            self.index = self.index + (1 as u64);
            return Option::Some(val);
        }
    }
}

impl<T> Drop for VecIntoIter<T> {
    fn drop(self: &rw Self) {
        while self.index < self.len {
            unsafe {
                dec item_ptr = ptr::add_mut<T>(self.ptr, self.index);
                ptr::drop_in_place<T>(item_ptr);
            }
            self.index = self.index + (1 as u64);
        }
        if self.cap > (0 as u64) {
            dec size = self.cap * (mem::size_of<T>() as u64);
            dec align = mem::align_of<T>() as u64;
            unsafe {
                __mellis_dealloc(self.ptr as *rw u8, size, align);
            }
            self.ptr = 0 as u64 as *rw T;
            self.cap = 0 as u64;
            self.len = 0 as u64;
        }
    }
}

// =========================================================================
// IntoIterator implementations for Vec<T>
// =========================================================================

// Owned: consumes Vec
impl<T> IntoIterator<T, VecIntoIter<T>> for Vec<T> {
    fn into_iter(self: Self) -> VecIntoIter<T> {
        dec rw result = VecIntoIter<T> {
            ptr: self.ptr,
            len: self.len,
            cap: self.cap,
            index: 0 as u64,
        };
        self.ptr = 0 as u64 as *rw T;
        self.len = 0 as u64;
        self.cap = 0 as u64;
        return result;
    }
}

// Borrowed: yields &T
impl<T> IntoIterator<&T, SliceIter<T>> for &Vec<T> {
    fn into_iter(self: Self) -> SliceIter<T> {
        return slice_iter<T>(self.as_slice());
    }
}



impl<T> Vec<T> {
    export fn push(self: &rw Self, item: T) {
        if self.len == self.cap {
            self.grow();
        }
        unsafe {
            dec target_ptr = ptr::add_mut<T>(self.ptr, self.len);
            ptr::write<T>(target_ptr, item);
        }
        self.len = self.len + (1 as u64);
    }

    export fn pop(self: &rw Self) -> Option<T> {
        if self.len == (0 as u64) {
            return Option::None;
        }
        self.len = self.len - (1 as u64);
        unsafe {
            dec target_ptr = ptr::add<T>(self.ptr as *T, self.len);
            return Option::Some(ptr::read<T>(target_ptr));
        }
    }

    export fn clear(self: &rw Self) {
        dec rw i = self.len;
        while i > (0 as u64) {
            i = i - (1 as u64);
            unsafe {
                ptr::drop_in_place<T>(ptr::add_mut<T>(self.ptr, i));
            }
        }
        self.len = 0 as u64;
    }

    export fn len(self: &Self) -> u64 {
        return self.len;
    }

    export fn capacity(self: &Self) -> u64 {
        return self.cap;
    }

    export fn is_empty(self: &Self) -> bool {
        return self.len == (0 as u64);
    }

    export fn last(self: &Self) -> Option<&T> life_from(self) {
        if self.len == (0 as u64) {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add<T>(self.ptr as *T, self.len - (1 as u64));
            return Option::Some(&*offset_ptr);
        }
    }

    export fn last_mut(self: &rw Self) -> Option<&rw T> life_from(self) {
        if self.len == (0 as u64) {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add_mut<T>(self.ptr, self.len - (1 as u64));
            return Option::Some(&rw *offset_ptr);
        }
    }

    export fn truncate(self: &rw Self, new_len: u64) {
        if new_len >= self.len {
            return;
        }
        dec rw i = self.len;
        while i > new_len {
            i = i - (1 as u64);
            unsafe {
                ptr::drop_in_place<T>(ptr::add_mut<T>(self.ptr, i));
            }
        }
        self.len = new_len;
    }

    export fn get(self: &Self, index: u64) -> Option<&T> life_from(self) {
        if index >= self.len {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add<T>(self.ptr as *T, index);
            return Option::Some(&*offset_ptr);
        }
    }

    export fn get_mut(self: &rw Self, index: u64) -> Option<&rw T> life_from(self) {
        if index >= self.len {
            return Option::None;
        }
        unsafe {
            dec offset_ptr = ptr::add_mut<T>(self.ptr, index);
            return Option::Some(&rw *offset_ptr);
        }
    }

    export fn as_slice(self: &Self) -> &[T] life_from(self) {
        unsafe {
            return slice_from_raw_parts<T>(self.ptr as *T, self.len);
        }
    }

    export fn as_mut_slice(self: &rw Self) -> &rw [T] life_from(self) {
        unsafe {
            return slice_from_raw_parts_mut<T>(self.ptr, self.len);
        }
    }

    export fn grow(self: &rw Self) {
        dec rw new_cap: u64 = 0 as u64;
        if self.cap == (0 as u64) {
            new_cap = 4 as u64;
        } else {
            new_cap = self.cap * (2 as u64);
        }
        
        dec new_size = new_cap * (mem::size_of<T>() as u64);
        dec align = mem::align_of<T>() as u64;
        dec new_ptr = __mellis_alloc(new_size, align) as u64 as *rw T;

        if self.cap > (0 as u64) {
            unsafe {
                ptr::copy<T>(self.ptr as *T, new_ptr, self.len);
            }
            dec old_size = self.cap * (mem::size_of<T>() as u64);
            __mellis_dealloc(self.ptr as *rw u8, old_size, align);
        }

        self.ptr = new_ptr;
        self.cap = new_cap;
    }

    export fn iter(self: &Self) -> SliceIter<T> life_from(self) {
        return slice_iter<T>(self.as_slice());
    }

    export fn iter_mut(self: &rw Self) -> SliceIterMut<T> life_from(self) {
        return slice_iter_mut<T>(self.as_mut_slice());
    }
}

impl<T> Drop for Vec<T> {
    fn drop(self: &rw Self) {
        dec rw i = self.len;
        while i > (0 as u64) {
            i = i - (1 as u64);
            unsafe {
                ptr::drop_in_place<T>(ptr::add_mut<T>(self.ptr, i));
            }
        }
        if self.cap > (0 as u64) {
            dec old_size = self.cap * (mem::size_of<T>() as u64);
            __mellis_dealloc(self.ptr as *rw u8, old_size, mem::align_of<T>() as u64);
        }
    }
}

module utf8 {
    export fn validate(bytes: &[u8]) -> bool {
        dec len = bytes.len as u64;
        dec rw i: u64 = 0 as u64;
        while i < len {
            dec b0 = bytes[i];
            if b0 <= (127 as u8) {
                i = i + (1 as u64);
            } else if (b0 >= (194 as u8)) && (b0 <= (223 as u8)) {
                if (i + (1 as u64)) >= len {
                    return false;
                }
                dec b1 = bytes[i + (1 as u64)];
                if (b1 < (128 as u8)) || (b1 > (191 as u8)) {
                    return false;
                }
                i = i + (2 as u64);
            } else if (b0 >= (224 as u8)) && (b0 <= (239 as u8)) {
                if (i + (2 as u64)) >= len {
                    return false;
                }
                dec b1 = bytes[i + (1 as u64)];
                dec b2 = bytes[i + (2 as u64)];
                if b0 == (224 as u8) {
                    if (b1 < (160 as u8)) || (b1 > (191 as u8)) {
                        return false;
                    }
                } else if b0 == (237 as u8) {
                    if (b1 < (128 as u8)) || (b1 > (159 as u8)) {
                        return false;
                    }
                } else {
                    if (b1 < (128 as u8)) || (b1 > (191 as u8)) {
                        return false;
                    }
                }
                if (b2 < (128 as u8)) || (b2 > (191 as u8)) {
                    return false;
                }
                i = i + (3 as u64);
            } else if (b0 >= (240 as u8)) && (b0 <= (244 as u8)) {
                if (i + (3 as u64)) >= len {
                    return false;
                }
                dec b1 = bytes[i + (1 as u64)];
                dec b2 = bytes[i + (2 as u64)];
                dec b3 = bytes[i + (3 as u64)];
                if b0 == (240 as u8) {
                    if (b1 < (144 as u8)) || (b1 > (191 as u8)) {
                        return false;
                    }
                } else if b0 == (244 as u8) {
                    if (b1 < (128 as u8)) || (b1 > (143 as u8)) {
                        return false;
                    }
                } else {
                    if (b1 < (128 as u8)) || (b1 > (191 as u8)) {
                        return false;
                    }
                }
                if (b2 < (128 as u8)) || (b2 > (191 as u8)) {
                    return false;
                }
                if (b3 < (128 as u8)) || (b3 > (191 as u8)) {
                    return false;
                }
                i = i + (4 as u64);
            } else {
                return false;
            }
        }
        return true;
    }

    export fn is_char_boundary(bytes: &[u8], index: u64) -> bool {
        dec len = bytes.len as u64;
        if index == (0 as u64) || index == len {
            return true;
        }
        if index > len {
            return false;
        }
        dec b = bytes[index];
        return (b & (192 as u8)) != (128 as u8);
    }

    export fn encode_char(ch: char, out_vec: &rw Vec<u8>) {
        dec code = ch as u32;
        if code <= (127 as u32) {
            out_vec.push(code as u8);
        } else if code <= (2047 as u32) {
            out_vec.push(((192 as u32) | (code >> (6 as u32))) as u8);
            out_vec.push(((128 as u32) | (code & (63 as u32))) as u8);
        } else if code <= (65535 as u32) {
            out_vec.push(((224 as u32) | (code >> (12 as u32))) as u8);
            out_vec.push(((128 as u32) | ((code >> (6 as u32)) & (63 as u32))) as u8);
            out_vec.push(((128 as u32) | (code & (63 as u32))) as u8);
        } else {
            out_vec.push(((240 as u32) | (code >> (18 as u32))) as u8);
            out_vec.push(((128 as u32) | ((code >> (12 as u32)) & (63 as u32))) as u8);
            out_vec.push(((128 as u32) | ((code >> (6 as u32)) & (63 as u32))) as u8);
            out_vec.push(((128 as u32) | (code & (63 as u32))) as u8);
        }
    }
}

module std {
    export struct String {
        private vec: Vec<u8>,
    }

    export fn string_new() -> String {
        return String {
            vec: vec_new<u8>(),
        };
    }

    export fn string_with_capacity(capacity: u64) -> String {
        return String {
            vec: vec_with_capacity<u8>(capacity),
        };
    }

    export fn string_from_bytes(bytes: &[u8]) -> Option<String> {
        if utf8::validate(bytes) == false {
            return Option::None;
        }
        dec len = bytes.len as u64;
        dec rw v = vec_with_capacity<u8>(len);
        dec rw i: u64 = 0 as u64;
        while i < len {
            v.push(bytes[i]);
            i = i + (1 as u64);
        }
        return Option::Some(String { vec: v });
    }

    export fn string_from_str(s: str) -> String {
        dec s_ptr = s as *u8;
        dec rw len: u64 = 0 as u64;
        unsafe {
            while (*(ptr::add<u8>(s_ptr, len))) != (0 as u8) {
                len = len + (1 as u64);
            }
            dec slice = slice_from_raw_parts<u8>(s_ptr, len);
            if utf8::validate(slice) == false {
                __mellis_panic();
            }
            dec rw v = vec_with_capacity<u8>(len);
            dec rw i: u64 = 0 as u64;
            while i < len {
                v.push(*(ptr::add<u8>(s_ptr, i)));
                i = i + (1 as u64);
            }
            return String { vec: v };
        }
    }

    impl String {
        export fn len(self: &Self) -> u64 {
            return self.vec.len();
        }

        export fn capacity(self: &Self) -> u64 {
            return self.vec.capacity();
        }

        export fn is_empty(self: &Self) -> bool {
            return self.vec.is_empty();
        }

        export fn as_bytes(self: &Self) -> &[u8] life_from(self) {
            return self.vec.as_slice();
        }

        export fn as_ptr(self: &Self) -> *u8 {
            return self.vec.ptr as *u8;
        }

        export fn push_char(self: &rw Self, ch: char) {
            utf8::encode_char(ch, &rw self.vec);
        }

        export fn push_str(self: &rw Self, s: str) {
            dec s_ptr = s as *u8;
            dec rw len: u64 = 0 as u64;
            unsafe {
                while (*(ptr::add<u8>(s_ptr, len))) != (0 as u8) {
                    len = len + (1 as u64);
                }
                dec slice = slice_from_raw_parts<u8>(s_ptr, len);
                if utf8::validate(slice) == false {
                    __mellis_panic();
                }
                dec rw i: u64 = 0 as u64;
                while i < len {
                    self.vec.push(*(ptr::add<u8>(s_ptr, i)));
                    i = i + (1 as u64);
                }
            }
        }

        export fn clear(self: &rw Self) {
            self.vec.clear();
        }

        export fn truncate(self: &rw Self, new_len: u64) {
            if new_len >= self.vec.len() {
                return;
            }
            if utf8::is_char_boundary(self.as_bytes(), new_len) == false {
                __mellis_panic();
            }
            self.vec.truncate(new_len);
        }

        export fn clone(self: &Self) -> String {
            dec bytes = self.as_bytes();
            dec len = bytes.len as u64;
            dec rw v = vec_with_capacity<u8>(len);
            dec rw i: u64 = 0 as u64;
            while i < len {
                v.push(bytes[i]);
                i = i + (1 as u64);
            }
            return String { vec: v };
        }

        export fn eq(self: &Self, other: &Self) -> bool {
            if self.len() != other.len() {
                return false;
            }
            dec b1 = self.as_bytes();
            dec b2 = other.as_bytes();
            dec len = b1.len as u64;
            dec rw i: u64 = 0 as u64;
            while i < len {
                if b1[i] != b2[i] {
                    return false;
                }
                i = i + (1 as u64);
            }
            return true;
        }
    }

    // =========================================================================
    // RawTable<K, V>: Internal Storage Engine for HashMap and HashSet
    //
    // Algorithm: Linear probing with first-tombstone reuse
    // Invariants:
    //   - Empty (0): Slot is vacant, terminates forward probe sequence.
    //   - Occupied (1): Slot holds a live, initialized K and V pair.
    //   - Deleted (2): Slot is a tombstone, probe sequence continues forward.
    // NOTE: RawTable is an internal implementation detail of the collection
    // abstractions (HashMap, HashSet) and is not a frozen user-facing API.
    // =========================================================================
    export enum ProbeResult {
        Found(u64),
        Vacant(u64),
    }

    export struct RawTable<K, V> {
        private states: *rw u8,
        private hashes: *rw u64,
        private keys: *rw K,
        private values: *rw V,
        private cap: u64,
        private len: u64,
        private tombstones: u64,
    }

    export fn raw_table_new<K, V>() -> RawTable<K, V> {
        return RawTable<K, V> {
            states: 0 as u64 as *rw u8,
            hashes: 0 as u64 as *rw u64,
            keys: 0 as u64 as *rw K,
            values: 0 as u64 as *rw V,
            cap: 0 as u64,
            len: 0 as u64,
            tombstones: 0 as u64,
        };
    }

    export fn raw_table_with_capacity<K, V>(capacity: u64) -> RawTable<K, V> {
        if capacity == (0 as u64) {
            return raw_table_new<K, V>();
        }
        dec rw cap: u64 = 8 as u64;
        while cap < capacity {
            cap = cap * (2 as u64);
        }
        dec k_size = cap * (mem::size_of<K>() as u64);
        dec k_align = mem::align_of<K>() as u64;
        dec v_size = cap * (mem::size_of<V>() as u64);
        dec v_align = mem::align_of<V>() as u64;

        dec states_ptr = __mellis_alloc(cap, 1 as u64);
        dec hashes_ptr = __mellis_alloc(cap * (8 as u64), 8 as u64) as *rw u64;
        dec keys_ptr = __mellis_alloc(k_size, k_align) as *rw K;
        dec values_ptr = __mellis_alloc(v_size, v_align) as *rw V;

        unsafe {
            mem::zero(states_ptr, cap);
        }

        return RawTable<K, V> {
            states: states_ptr,
            hashes: hashes_ptr,
            keys: keys_ptr,
            values: values_ptr,
            cap: cap,
            len: 0 as u64,
            tombstones: 0 as u64,
        };
    }

    impl<K: Hash + Eq, V> RawTable<K, V> {
        export fn len(self: &Self) -> u64 {
            return self.len;
        }

        export fn capacity(self: &Self) -> u64 {
            return self.cap;
        }

        export fn tombstones(self: &Self) -> u64 {
            return self.tombstones;
        }

        export fn is_empty(self: &Self) -> bool {
            return self.len == (0 as u64);
        }

        // Probing strategy: Linear probing with first-tombstone reuse.
        // Search rule:
        //   - Occupied: compare hash -> Eq
        //   - Deleted: continue probing (never terminate search)
        //   - Empty: terminate search
        export fn find(self: &Self, key: &K, hash: u64) -> ProbeResult {
            if self.cap == (0 as u64) {
                return ProbeResult::Vacant(0 as u64);
            }
            dec mask = self.cap - (1 as u64);
            dec rw idx = hash & mask;
            dec rw first_tombstone: u64 = self.cap;
            dec rw step: u64 = 0 as u64;

            while step < self.cap {
                dec rw state_val: u8 = 0 as u8;
                unsafe {
                    state_val = *ptr::add<u8>(self.states as *u8, idx);
                }
                if state_val == (0 as u8) {
                    if first_tombstone < self.cap {
                        return ProbeResult::Vacant(first_tombstone);
                    } else {
                        return ProbeResult::Vacant(idx);
                    }
                }
                if state_val == (2 as u8) {
                    if first_tombstone == self.cap {
                        first_tombstone = idx;
                    }
                }
                if state_val == (1 as u8) {
                    dec rw stored_hash: u64 = 0 as u64;
                    dec rw is_eq: bool = false;
                    unsafe {
                        stored_hash = *ptr::add<u64>(self.hashes as *u64, idx);
                        if stored_hash == hash {
                            dec stored_key_ptr = ptr::add<K>(self.keys as *K, idx);
                            is_eq = key.eq(&*stored_key_ptr);
                        }
                    }
                    if stored_hash == hash && is_eq {
                        return ProbeResult::Found(idx);
                    }
                }
                step = step + (1 as u64);
                idx = (idx + (1 as u64)) & mask;
            }

            if first_tombstone < self.cap {
                return ProbeResult::Vacant(first_tombstone);
            }
            return ProbeResult::Vacant(self.cap);
        }

        export fn insert(self: &rw Self, key: K, val: V) -> bool {
            if self.cap == (0 as u64) || ((self.len + self.tombstones + (1 as u64)) * (4 as u64) >= self.cap * (3 as u64)) {
                self.grow();
            }
            dec hash = key.hash();
            dec probe = self.find(&key, hash);
            match probe {
                ProbeResult::Found(idx) -> {
                    unsafe {
                        dec val_dst = ptr::add_mut<V>(self.values, idx);
                        ptr::drop_in_place<V>(val_dst);
                        ptr::write<V>(val_dst, val);
                    }
                    return false;
                },
                ProbeResult::Vacant(idx) -> {
                    unsafe {
                        dec state_ptr = ptr::add_mut<u8>(self.states, idx);
                        if *state_ptr == (2 as u8) {
                            self.tombstones = self.tombstones - (1 as u64);
                        }
                        *state_ptr = 1 as u8;
                        dec hash_ptr = ptr::add_mut<u64>(self.hashes, idx);
                        *hash_ptr = hash;
                        dec key_dst = ptr::add_mut<K>(self.keys, idx);
                        ptr::write<K>(key_dst, key);
                        dec val_dst = ptr::add_mut<V>(self.values, idx);
                        ptr::write<V>(val_dst, val);
                    }
                    self.len = self.len + (1 as u64);
                    return true;
                },
            }
        }

        export fn get(self: &Self, key: &K) -> Option<&V> life_from(self) {
            if self.len == (0 as u64) {
                return Option::None;
            }
            dec hash = key.hash();
            dec probe = self.find(key, hash);
            match probe {
                ProbeResult::Found(idx) -> {
                    unsafe {
                        dec val_ptr = ptr::add<V>(self.values as *V, idx);
                        return Option::Some(&*val_ptr);
                    }
                },
                ProbeResult::Vacant(_) -> {
                    return Option::None;
                },
            }
        }

        export fn get_mut(self: &rw Self, key: &K) -> Option<&rw V> life_from(self) {
            if self.len == (0 as u64) {
                return Option::None;
            }
            dec hash = key.hash();
            dec probe = self.find(key, hash);
            match probe {
                ProbeResult::Found(idx) -> {
                    unsafe {
                        dec val_ptr = ptr::add_mut<V>(self.values, idx);
                        return Option::Some(&rw *val_ptr);
                    }
                },
                ProbeResult::Vacant(_) -> {
                    return Option::None;
                },
            }
        }

        export fn contains_key(self: &Self, key: &K) -> bool {
            if self.len == (0 as u64) {
                return false;
            }
            dec hash = key.hash();
            dec probe = self.find(key, hash);
            match probe {
                ProbeResult::Found(_) -> true,
                ProbeResult::Vacant(_) -> false,
            }
        }

        export fn remove(self: &rw Self, key: &K) -> bool {
            if self.len == (0 as u64) {
                return false;
            }
            dec hash = key.hash();
            dec probe = self.find(key, hash);
            match probe {
                ProbeResult::Found(idx) -> {
                    unsafe {
                        dec key_ptr = ptr::add_mut<K>(self.keys, idx);
                        ptr::drop_in_place<K>(key_ptr);
                        dec val_ptr = ptr::add_mut<V>(self.values, idx);
                        ptr::drop_in_place<V>(val_ptr);
                        dec state_ptr = ptr::add_mut<u8>(self.states, idx);
                        *state_ptr = 2 as u8;
                    }
                    self.len = self.len - (1 as u64);
                    self.tombstones = self.tombstones + (1 as u64);
                    return true;
                },
                ProbeResult::Vacant(_) -> {
                    return false;
                },
            }
        }

        export fn clear(self: &rw Self) {
            if self.len > (0 as u64) {
                dec rw i: u64 = 0 as u64;
                while i < self.cap {
                    dec rw state_val: u8 = 0 as u8;
                    unsafe {
                        state_val = *ptr::add<u8>(self.states as *u8, i);
                        if state_val == (1 as u8) {
                            ptr::drop_in_place<K>(ptr::add_mut<K>(self.keys, i));
                            ptr::drop_in_place<V>(ptr::add_mut<V>(self.values, i));
                        }
                    }
                    i = i + (1 as u64);
                }
                unsafe {
                    mem::zero(self.states, self.cap);
                }
                self.len = 0 as u64;
                self.tombstones = 0 as u64;
            }
        }

        fn grow(self: &rw Self) {
            dec rw new_cap: u64 = 8 as u64;
            if self.cap > (0 as u64) {
                if self.len * (2 as u64) <= self.cap {
                    new_cap = self.cap;
                } else {
                    new_cap = self.cap * (2 as u64);
                }
            }

            dec k_size = new_cap * (mem::size_of<K>() as u64);
            dec k_align = mem::align_of<K>() as u64;
            dec v_size = new_cap * (mem::size_of<V>() as u64);
            dec v_align = mem::align_of<V>() as u64;

            dec new_states = __mellis_alloc(new_cap, 1 as u64);
            dec new_hashes = __mellis_alloc(new_cap * (8 as u64), 8 as u64) as *rw u64;
            dec new_keys = __mellis_alloc(k_size, k_align) as *rw K;
            dec new_values = __mellis_alloc(v_size, v_align) as *rw V;

            unsafe {
                mem::zero(new_states, new_cap);
            }

            if self.cap > (0 as u64) {
                dec new_mask = new_cap - (1 as u64);
                dec rw i: u64 = 0 as u64;
                while i < self.cap {
                    dec rw state_val: u8 = 0 as u8;
                    unsafe {
                        state_val = *ptr::add<u8>(self.states as *u8, i);
                    }
                    if state_val == (1 as u8) {
                        unsafe {
                            dec cached_hash = *ptr::add<u64>(self.hashes as *u64, i);
                            dec k = ptr::read<K>(ptr::add<K>(self.keys as *K, i));
                            dec v = ptr::read<V>(ptr::add<V>(self.values as *V, i));

                            dec rw new_idx = cached_hash & new_mask;
                            while *ptr::add<u8>(new_states as *u8, new_idx) != (0 as u8) {
                                new_idx = (new_idx + (1 as u64)) & new_mask;
                            }

                            *ptr::add_mut<u8>(new_states, new_idx) = 1 as u8;
                            *ptr::add_mut<u64>(new_hashes, new_idx) = cached_hash;
                            ptr::write<K>(ptr::add_mut<K>(new_keys, new_idx), k);
                            ptr::write<V>(ptr::add_mut<V>(new_values, new_idx), v);
                        }
                    }
                    i = i + (1 as u64);
                }

                dec old_k_size = self.cap * (mem::size_of<K>() as u64);
                dec old_k_align = mem::align_of<K>() as u64;
                dec old_v_size = self.cap * (mem::size_of<V>() as u64);
                dec old_v_align = mem::align_of<V>() as u64;

                unsafe {
                    __mellis_dealloc(self.states, self.cap, 1 as u64);
                    __mellis_dealloc(self.hashes as *rw u8, self.cap * (8 as u64), 8 as u64);
                    __mellis_dealloc(self.keys as *rw u8, old_k_size, old_k_align);
                    __mellis_dealloc(self.values as *rw u8, old_v_size, old_v_align);
                }
            }

            self.states = new_states;
            self.hashes = new_hashes;
            self.keys = new_keys;
            self.values = new_values;
            self.cap = new_cap;
            self.tombstones = 0 as u64;
        }

        export fn iter(self: &Self) -> RawTableIter<K, V> {
            return RawTableIter<K, V> {
                states: self.states as *u8,
                keys: self.keys as *K,
                values: self.values as *V,
                idx: 0 as u64,
                cap: self.cap,
            };
        }
    }

    impl<K, V> Drop for RawTable<K, V> {
        fn drop(self: &rw Self) {
            if (self.states as u64) != (0 as u64) && self.cap > (0 as u64) {
                dec rw i: u64 = 0 as u64;
                while i < self.cap {
                    dec rw state_val: u8 = 0 as u8;
                    unsafe {
                        state_val = *ptr::add<u8>(self.states as *u8, i);
                        if state_val == (1 as u8) {
                            ptr::drop_in_place<K>(ptr::add_mut<K>(self.keys, i));
                            ptr::drop_in_place<V>(ptr::add_mut<V>(self.values, i));
                        }
                    }
                    i = i + (1 as u64);
                }
                dec k_size = self.cap * (mem::size_of<K>() as u64);
                dec k_align = mem::align_of<K>() as u64;
                dec v_size = self.cap * (mem::size_of<V>() as u64);
                dec v_align = mem::align_of<V>() as u64;

                unsafe {
                    __mellis_dealloc(self.states, self.cap, 1 as u64);
                    __mellis_dealloc(self.hashes as *rw u8, self.cap * (8 as u64), 8 as u64);
                    __mellis_dealloc(self.keys as *rw u8, k_size, k_align);
                    __mellis_dealloc(self.values as *rw u8, v_size, v_align);
                }

                self.states = 0 as u64 as *rw u8;
                self.hashes = 0 as u64 as *rw u64;
                self.keys = 0 as u64 as *rw K;
                self.values = 0 as u64 as *rw V;
                self.cap = 0 as u64;
                self.len = 0 as u64;
                self.tombstones = 0 as u64;
            }
        }
    }

    // =========================================================================
    // Collection Iterators: RawTableIter, MapIter, Keys, Values, RawTableIntoIter, MapIntoIter, SetIntoIter
    // =========================================================================

    export struct RawTableIntoIter<K, V> {
        private table: RawTable<K, V>,
        private idx: u64,
    }

    impl<K, V> RawTableIntoIter<K, V> {
        export fn next(self: &rw Self) -> Option<(K, V)> {
            while self.idx < self.table.capacity() {
                dec cur = self.idx;
                self.idx = self.idx + (1 as u64);
                unsafe {
                    dec state_ptr = ptr::add_mut<u8>(self.table.states as *rw u8, cur);
                    dec state_val = *state_ptr;
                    if state_val == (1 as u8) {
                        *state_ptr = 0 as u8;
                        dec k_ptr = ptr::add<K>(self.table.keys as *K, cur);
                        dec v_ptr = ptr::add<V>(self.table.values as *V, cur);
                        dec k = ptr::read<K>(k_ptr);
                        dec v = ptr::read<V>(v_ptr);
                        return Option::Some((k, v));
                    }
                }
            }
            return Option::None;
        }
    }

    export struct MapIntoIter<K, V> {
        private raw: RawTableIntoIter<K, V>,
    }

    impl<K, V> MapIntoIter<K, V> {
        export fn next(self: &rw Self) -> Option<(K, V)> {
            return self.raw.next();
        }
    }

    impl<K, V> Iterator<(K, V)> for MapIntoIter<K, V> {
        fn next(self: &rw Self) -> Option<(K, V)> {
            return self.raw.next();
        }
    }

    export struct SetIntoIter<T> {
        private map: MapIntoIter<T, ()>,
    }

    impl<T> SetIntoIter<T> {
        export fn next(self: &rw Self) -> Option<T> {
            dec opt = self.map.next();
            match opt {
                Option::Some(tup) -> {
                    return Option::Some(tup.0);
                }
                Option::None -> {
                    return Option::None;
                }
            }
        }
    }

    impl<T> Iterator<T> for SetIntoIter<T> {
        fn next(self: &rw Self) -> Option<T> {
            return self.next();
        }
    }

    export struct RawTableIter<K, V> {
        private states: *u8,
        private keys: *K,
        private values: *V,
        private idx: u64,
        private cap: u64,
    }

    impl<K, V> RawTableIter<K, V> {
        export fn next_entry(self: &rw Self) -> Option<(&K, &V)> {
            while self.idx < self.cap {
                dec cur = self.idx;
                self.idx = self.idx + (1 as u64);
                unsafe {
                    dec state_val = *ptr::add<u8>(self.states, cur);
                    if state_val == (1 as u8) {
                        dec k_ptr = ptr::add<K>(self.keys, cur);
                        dec v_ptr = ptr::add<V>(self.values, cur);
                        return Option::Some((&*k_ptr, &*v_ptr));
                    }
                }
            }
            return Option::None;
        }

        export fn next_key(self: &rw Self) -> Option<&K> {
            while self.idx < self.cap {
                dec cur = self.idx;
                self.idx = self.idx + (1 as u64);
                unsafe {
                    dec state_val = *ptr::add<u8>(self.states, cur);
                    if state_val == (1 as u8) {
                        dec k_ptr = ptr::add<K>(self.keys, cur);
                        return Option::Some(&*k_ptr);
                    }
                }
            }
            return Option::None;
        }

        export fn next_value(self: &rw Self) -> Option<&V> {
            while self.idx < self.cap {
                dec cur = self.idx;
                self.idx = self.idx + (1 as u64);
                unsafe {
                    dec state_val = *ptr::add<u8>(self.states, cur);
                    if state_val == (1 as u8) {
                        dec v_ptr = ptr::add<V>(self.values, cur);
                        return Option::Some(&*v_ptr);
                    }
                }
            }
            return Option::None;
        }
    }

    export struct MapIter<K, V> {
        private raw: RawTableIter<K, V>,
    }

    impl<K, V> MapIter<K, V> {
        export fn next(self: &rw Self) -> Option<(&K, &V)> {
            return self.raw.next_entry();
        }
    }

    impl<K, V> Iterator<(&K, &V)> for MapIter<K, V> {
        fn next(self: &rw Self) -> Option<(&K, &V)> {
            return self.raw.next_entry();
        }
    }

    export struct Keys<K, V> {
        private raw: RawTableIter<K, V>,
    }

    impl<K, V> Keys<K, V> {
        export fn next(self: &rw Self) -> Option<&K> {
            return self.raw.next_key();
        }
    }

    impl<K, V> Iterator<&K> for Keys<K, V> {
        fn next(self: &rw Self) -> Option<&K> {
            return self.raw.next_key();
        }
    }

    export struct Values<K, V> {
        private raw: RawTableIter<K, V>,
    }

    impl<K, V> Values<K, V> {
        export fn next(self: &rw Self) -> Option<&V> {
            return self.raw.next_value();
        }
    }

    impl<K, V> Iterator<&V> for Values<K, V> {
        fn next(self: &rw Self) -> Option<&V> {
            return self.raw.next_value();
        }
    }

    // =========================================================================
    // HashMap<K, V>: Canonical Key-Value Hash Map Collection
    //
    // Thin semantic wrapper around RawTable<K, V>.
    // =========================================================================
    export struct HashMap<K, V> {
        private table: RawTable<K, V>,
    }

    export fn hashmap_new<K, V>() -> HashMap<K, V> {
        return HashMap<K, V> {
            table: raw_table_new<K, V>(),
        };
    }

    export fn hashmap_with_capacity<K, V>(capacity: u64) -> HashMap<K, V> {
        return HashMap<K, V> {
            table: raw_table_with_capacity<K, V>(capacity),
        };
    }

    impl<K: Hash + Eq, V> HashMap<K, V> {
        export fn len(self: &Self) -> u64 {
            return self.table.len();
        }

        export fn capacity(self: &Self) -> u64 {
            return self.table.capacity();
        }

        export fn is_empty(self: &Self) -> bool {
            return self.table.is_empty();
        }

        export fn insert(self: &rw Self, key: K, val: V) -> bool {
            return self.table.insert(key, val);
        }

        export fn get(self: &Self, key: &K) -> Option<&V> life_from(self) {
            return self.table.get(key);
        }

        export fn get_mut(self: &rw Self, key: &K) -> Option<&rw V> life_from(self) {
            return self.table.get_mut(key);
        }

        export fn contains_key(self: &Self, key: &K) -> bool {
            return self.table.contains_key(key);
        }

        export fn remove(self: &rw Self, key: &K) -> bool {
            return self.table.remove(key);
        }

        export fn clear(self: &rw Self) {
            self.table.clear();
        }

        export fn iter(self: &Self) -> MapIter<K, V> {
            return MapIter<K, V> {
                raw: self.table.iter(),
            };
        }

        export fn into_iter(self: Self) -> MapIntoIter<K, V> {
            return MapIntoIter<K, V> {
                raw: RawTableIntoIter<K, V> {
                    table: self.table,
                    idx: 0 as u64,
                }
            };
        }

        export fn keys(self: &Self) -> Keys<K, V> {
            return Keys<K, V> {
                raw: self.table.iter(),
            };
        }

        export fn values(self: &Self) -> Values<K, V> {
            return Values<K, V> {
                raw: self.table.iter(),
            };
        }
    }

    export struct SetIter<T> {
        private keys: Keys<T, ()>,
    }

    impl<T> SetIter<T> {
        export fn next(self: &rw Self) -> Option<&T> {
            return self.keys.next();
        }
    }

    impl<T> Iterator<&T> for SetIter<T> {
        fn next(self: &rw Self) -> Option<&T> {
            return self.keys.next();
        }
    }

    export struct HashSet<T> {
        private map: HashMap<T, ()>,
    }

    export fn hashset_new<T>() -> HashSet<T> {
        return HashSet {
            map: hashmap_new<T, ()>(),
        };
    }

    export fn hashset_with_capacity<T>(capacity: u64) -> HashSet<T> {
        return HashSet {
            map: hashmap_with_capacity<T, ()>(capacity),
        };
    }

    impl<T: Hash + Eq> HashSet<T> {
        export fn len(self: &Self) -> u64 {
            return self.map.len();
        }

        export fn capacity(self: &Self) -> u64 {
            return self.map.capacity();
        }

        export fn is_empty(self: &Self) -> bool {
            return self.map.is_empty();
        }

        export fn insert(self: &rw Self, value: T) -> bool {
            return self.map.insert(value, ());
        }

        export fn contains(self: &Self, value: &T) -> bool {
            return self.map.contains_key(value);
        }

        export fn remove(self: &rw Self, value: &T) -> bool {
            return self.map.remove(value);
        }

        export fn clear(self: &rw Self) {
            self.map.clear();
        }

        export fn iter(self: &Self) -> SetIter<T> {
            return SetIter<T> {
                keys: self.map.keys(),
            };
        }

        export fn into_iter(self: Self) -> SetIntoIter<T> {
            return SetIntoIter<T> {
                map: self.map.into_iter(),
            };
        }
    }
}

export type String = std::String;
export fn string_new() -> String {
    return std::string_new();
}
export fn string_with_capacity(capacity: u64) -> String {
    return std::string_with_capacity(capacity);
}
export fn string_from_str(s: str) -> String {
    return std::string_from_str(s);
}
export fn string_from_bytes(bytes: &[u8]) -> Option<String> {
    return std::string_from_bytes(bytes);
}

export type ProbeResult = std::ProbeResult;
export type RawTable<K, V> = std::RawTable<K, V>;
export fn raw_table_new<K, V>() -> RawTable<K, V> {
    return std::raw_table_new<K, V>();
}
export fn raw_table_with_capacity<K, V>(capacity: u64) -> RawTable<K, V> {
    return std::raw_table_with_capacity<K, V>(capacity);
}

export type RawTableIter<K, V> = std::RawTableIter<K, V>;
export type MapIter<K, V> = std::MapIter<K, V>;
export type Keys<K, V> = std::Keys<K, V>;
export type Values<K, V> = std::Values<K, V>;
export type SetIter<T> = std::SetIter<T>;
export type RawTableIntoIter<K, V> = std::RawTableIntoIter<K, V>;
export type MapIntoIter<K, V> = std::MapIntoIter<K, V>;
export type SetIntoIter<T> = std::SetIntoIter<T>;


export type HashMap<K, V> = std::HashMap<K, V>;
export fn hashmap_new<K, V>() -> HashMap<K, V> {
    return std::hashmap_new<K, V>();
}
export fn hashmap_with_capacity<K, V>(capacity: u64) -> HashMap<K, V> {
    return std::hashmap_with_capacity<K, V>(capacity);
}

export type HashSet<T> = std::HashSet<T>;
export fn hashset_new<T>() -> HashSet<T> {
    return std::hashset_new<T>();
}
export fn hashset_with_capacity<T>(capacity: u64) -> HashSet<T> {
    return std::hashset_with_capacity<T>(capacity);
}

export fn iter_collect_vec<I: Iterator<Item>, Item>(iter: I) -> Vec<Item> {
    dec rw vec = vec_new<Item>();
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                vec.push(x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return vec;
}

export fn iter_collect_hashset<I: Iterator<Item>, Item: Hash + Eq>(iter: I) -> HashSet<Item> {
    dec rw set = hashset_new<Item>();
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some(x) -> {
                set.insert(x);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return set;
}

export fn iter_collect_hashmap<I: Iterator<(K, V)>, K: Hash + Eq, V>(iter: I) -> HashMap<K, V> {
    dec rw map = hashmap_new<K, V>();
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            Option::Some((k, v)) -> {
                map.insert(k, v);
            },
            Option::None -> {
                running = false;
            },
        }
    }
    return map;
}


impl<K, V> IntoIterator<(K, V), MapIntoIter<K, V>> for std::HashMap<K, V> {
    fn into_iter(self: Self) -> MapIntoIter<K, V> {
        return self.into_iter();
    }
}

impl<K, V> IntoIterator<(&K, &V), MapIter<K, V>> for &std::HashMap<K, V> {
    fn into_iter(self: Self) -> MapIter<K, V> {
        return self.iter();
    }
}

impl<T> IntoIterator<T, SetIntoIter<T>> for std::HashSet<T> {
    fn into_iter(self: Self) -> SetIntoIter<T> {
        return self.into_iter();
    }
}

impl<T> IntoIterator<&T, SetIter<T>> for &std::HashSet<T> {
    fn into_iter(self: Self) -> SetIter<T> {
        return self.iter();
    }
}
