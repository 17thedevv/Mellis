// SEM-ASSOC-02 provider A: owns the trait, concrete type, and associated binding.
export trait Producer {
    type Output;
    fn produce(self: &Self) -> Self::Output;
}

export struct Num {
    value: i32,
}

impl Producer for Num {
    type Output = i32;
    fn produce(self: &Self) -> i32 {
        return self.value;
    }
}

export fn make_num(value: i32) -> Num {
    return Num { value: value };
}
