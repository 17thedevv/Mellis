// SEM-ASSOC-02: valid projection when trait and impl come from distinct providers.
import "trait_provider";
import "impl_provider";

fn output_of<T: Producer>(value: &T) -> T::Output {
    return value.produce();
}

fn main() -> i32 {
    dec num = make_num(42);
    return output_of<Num>(&num) - 42;
}
