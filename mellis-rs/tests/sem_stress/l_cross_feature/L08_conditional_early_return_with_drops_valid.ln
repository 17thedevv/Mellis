// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
fn branch_calc(mode: i32, input: i32) -> i32 {
    if mode == 1 {
        dec a = input * 2;
        if a > 40 {
            return a - 8;
        } else {
            return a + 2;
        }
    } else if mode == 2 {
        dec b = input * 3;
        return b;
    }
    return 0;
}

fn main() -> i32 {
    return branch_calc(1, 25);
}
