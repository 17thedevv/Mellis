// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
enum Phase {
    AddTen,
    AddTwo,
    Done,
}

fn main() -> i32 {
    dec rw total: i32 = 0;
    dec rw p: Phase = Phase::AddTen;
    dec rw running: bool = true;
    while running {
        match p {
            Phase::AddTen -> {
                total = total + 40;
                p = Phase::AddTwo;
            },
            Phase::AddTwo -> {
                total = total + 2;
                p = Phase::Done;
            },
            Phase::Done -> {
                running = false;
            },
        };
    }
    return total;
}
