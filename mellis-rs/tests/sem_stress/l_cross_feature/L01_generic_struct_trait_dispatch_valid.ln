// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
struct Wrapper<T> {
    val: T,
};

trait Extract<T> {
    fn get(self: &Self) -> T;
}

impl<T> Extract<T> for Wrapper<T> {
    fn get(self: &Self) -> T {
        return self.val;
    }
}

fn main() -> i32 {
    dec w = Wrapper<i32> { val: 42 };
    return w.get();
}
