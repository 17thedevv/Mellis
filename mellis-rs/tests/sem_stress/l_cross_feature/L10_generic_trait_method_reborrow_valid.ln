// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
trait Increment {
    fn inc(self: &rw Self);
}

struct Counter {
    val: i32,
};

impl Increment for Counter {
    fn inc(self: &rw Self) {
        self.val = self.val + 1;
    }
}

fn do_increment<T: Increment>(item: &rw T) {
    item.inc();
}

fn main() -> i32 {
    dec rw c = Counter { val: 41 };
    do_increment<Counter>(&rw c);
    return c.val;
}
