// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
trait Numeric {
    fn val(self: &Self) -> i32;
}

struct Score {
    s: i32,
};

impl Numeric for Score {
    fn val(self: &Self) -> i32 {
        return self.s;
    }
}

fn double_val<T: Numeric>(item: &T) -> i32 {
    return item.val() * 2;
}

fn main() -> i32 {
    dec sc = Score { s: 21 };
    return double_val<Score>(&sc);
}
