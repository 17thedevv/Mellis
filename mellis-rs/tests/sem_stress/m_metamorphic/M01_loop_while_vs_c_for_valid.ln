// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
fn main() -> i32 {
    dec rw sum_while: i32 = 0;
    dec rw i: i32 = 1;
    while i <= 5 {
        sum_while = sum_while + i;
        i = i + 1;
    }

    dec rw sum_for: i32 = 0;
    for (dec rw j: i32 = 1; j <= 5; j = j + 1) {
        sum_for = sum_for + j;
    }

    if sum_while == sum_for {
        return sum_while * 2 + 12;
    }
    return 0;
}
