// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 42]
fn add_fourteen(target: &rw i32) {
    *target = *target + 14;
}

fn forward_step(target: &rw i32) {
    add_fourteen(target);
}

fn outer_step(target: &rw i32) {
    forward_step(target);
}

fn main() -> i32 {
    dec rw val: i32 = 0;
    outer_step(&rw val);
    outer_step(&rw val);
    outer_step(&rw val);
    return val;
}
