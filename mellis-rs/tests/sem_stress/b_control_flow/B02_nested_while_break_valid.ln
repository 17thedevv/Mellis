// [STRESS: COMPILE_ACCEPT]
// [STRESS: EXEC_EXIT: 6]
fn main() -> i32 {
    dec rw total = 0;
    dec rw i = 0;
    while i < 3 {
        dec rw j = 0;
        while true {
            if j == 2 {
                break;
            }
            total = total + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}
