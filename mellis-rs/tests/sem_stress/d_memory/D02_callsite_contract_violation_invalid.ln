// [STRESS: COMPILE_REJECT: E2016]
fn add_refs(sup: &i32, sub: &i32) -> i32 requires life(sup) >= life(sub) {
    return *sup + *sub;
}

fn main() -> i32 {
    dec outer = 40;
    dec rw res = 0;
    while (res == 0) {
        dec inner = 2;
        res = add_refs(&inner, &outer);
    }
    return res;
}
