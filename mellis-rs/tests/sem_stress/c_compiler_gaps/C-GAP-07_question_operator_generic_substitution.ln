import <result>;
import <try>;

// 1. Monomorphic caller with monomorphic callee using Result<i32, i32>
fn step_add(val: i32) -> Result<i32, i32> {
    if val < 0 {
        return Result::Err(val);
    }
    return Result::Ok(val + 10);
}

fn compute_chain(init: i32) -> Result<i32, i32> {
    dec a = step_add(init)?;
    dec b = step_add(a)?;
    return Result::Ok(b + 5);
}

// 2. Generic caller with generic callee using Result<T, E>
fn generic_identity<T, E>(val: Result<T, E>) -> Result<T, E> {
    dec inner = val?;
    return Result::Ok(inner);
}

// 3. Generic helper forwarding to nested generic
fn nested_generic_forward<T, E>(val: Result<T, E>) -> Result<T, E> {
    dec unwrapped = generic_identity(val)?;
    return Result::Ok(unwrapped);
}

fn main() -> i32 {
    // Test 1: Successful sequential try chain
    dec res1 = compute_chain(5);
    match res1 {
        Result::Ok(v) -> {
            if v != 30 {
                return 1;
            }
        },
        Result::Err(_) -> {
            return 2;
        },
    }

    // Test 2: Early return on failure in try chain
    dec res2 = compute_chain(-1);
    match res2 {
        Result::Ok(_) -> {
            return 3;
        },
        Result::Err(e) -> {
            if e != -1 {
                return 4;
            }
        },
    }

    // Test 3: Generic try monomorphization with concrete types
    dec ok_in: Result<i32, i32> = Result::Ok(42);
    dec res3 = nested_generic_forward(ok_in);
    match res3 {
        Result::Ok(v) -> {
            if v != 42 {
                return 5;
            }
        },
        Result::Err(_) -> {
            return 6;
        },
    }

    return 0;
}
