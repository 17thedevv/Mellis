struct Counter {
    value: i32,
}

impl Counter {
    fn advance(self: &rw Self) -> i32 {
        dec current = self.value;
        self.value = self.value + 1;
        return current;
    }
}

fn main() -> i32 {
    dec rw counter = Counter { value: 4 };
    dec a = counter.advance();
    dec b = counter.advance();
    dec c = counter.advance();
    if a != 4 || b != 5 || c != 6 || counter.value != 7 {
        return 1;
    }
    return 0;
}
