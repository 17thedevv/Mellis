import <core>;
import <alloc>;

fn test_borrow_reject() -> &u64 {
    dec rw map = hashmap_new<u64, u64>();
    map.insert(10 as u64, 100 as u64);
    
    dec dummy = 0 as u64;
    dec rw ret = &dummy;
    for (k, v) in &map {
        ret = k;
    }
    
    return ret;
}

export fn main() -> i32 {
    test_borrow_reject();
    return 0;
}
