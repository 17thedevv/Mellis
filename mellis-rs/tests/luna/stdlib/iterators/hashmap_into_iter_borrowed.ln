import <core>;
import <alloc>;


fn test_hashmap_into_iter_borrowed() -> i32 {
    dec rw map = hashmap_new<u64, u64>();
    map.insert(10 as u64, 100 as u64);
    map.insert(20 as u64, 200 as u64);
    map.insert(30 as u64, 300 as u64);

    dec rw sum_k = 0 as u64;
    dec rw sum_v = 0 as u64;

    for (k, v) in &map {
        sum_k = sum_k + *k;
        sum_v = sum_v + *v;
    }

    if sum_k != (60 as u64) {
        return 1;
    }
    if sum_v != (600 as u64) {
        return 1;
    }

    // Verify map is still usable
    if map.len() != (3 as u64) {
        return 1;
    }
    return 0;
}

export fn main() -> i32 {
    test_hashmap_into_iter_borrowed();
    return 0;
}
