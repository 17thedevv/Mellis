import <core>;
import <alloc>;

fn test_borrow_reject() -> &u64 {
    dec rw set = hashset_new<u64>();
    set.insert(10 as u64);
    
    dec rw ret = Option::None<&u64>();
    for k in &set {
        ret = Option::Some<&u64>(k);
    }
    
    return ret.unwrap();
}

export fn main() -> i32 {
    test_borrow_reject();
    return 0;
}
