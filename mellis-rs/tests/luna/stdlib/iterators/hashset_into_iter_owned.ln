import <core>;
import <alloc>;


fn test_hashset_into_iter_owned() -> i32 {
    dec rw set = hashset_new<u64>();
    set.insert(10 as u64);
    set.insert(20 as u64);
    set.insert(30 as u64);

    dec rw sum = 0 as u64;

    for x in set {
        sum = sum + x;
    }

    if sum != (60 as u64) {
        return 1;
    }
    return 0;
}

export fn main() -> i32 {
    test_hashset_into_iter_owned();
    return 0;
}
