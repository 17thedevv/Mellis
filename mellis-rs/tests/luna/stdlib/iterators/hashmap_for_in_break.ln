import <core>;
import <alloc>;

fn test_hashmap_for_in_break() -> i32 {
    dec rw map = hashmap_new<u64, u64>();
    map.insert(10 as u64, 100 as u64);
    map.insert(20 as u64, 200 as u64);
    map.insert(30 as u64, 300 as u64);
    
    dec rw count = 0 as u64;
    for (k, v) in map {
        count = count + (1 as u64);
        break;
    }

    if count != (1 as u64) {
        return 1;
    }
    return 0;
}

export fn main() -> i32 {
    test_hashmap_for_in_break();
    return 0;
}
