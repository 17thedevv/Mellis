import <core>;
import <alloc>;

struct Tracker {
    id: u64,
    count_ptr: *rw u64,
}

impl Drop for Tracker {
    fn drop(self: &rw Self) {
        unsafe {
            dec current = ptr::read(self.count_ptr as *u64);
            ptr::write(self.count_ptr, current + (1 as u64));
        }
    }
}

impl Hash for Tracker {
    fn hash(self: &Self) -> u64 {
        return self.id;
    }
}

impl Eq for Tracker {
    fn eq(self: &Self, other: &Self) -> bool {
        return self.id == other.id;
    }
}

fn test_c8() -> i32 {
    dec rw dropped_vals = 0 as u64;
    dec v_ptr = &rw dropped_vals as *rw u64;

    dec rw set = hashset_new<Tracker>();
    set.insert(Tracker { id: 10 as u64, count_ptr: v_ptr });
    set.insert(Tracker { id: 20 as u64, count_ptr: v_ptr });
    set.insert(Tracker { id: 30 as u64, count_ptr: v_ptr });

    dec rw count = 0 as u64;
    for x in set {
        count = count + (1 as u64);
        break;
    }

    if dropped_vals != (3 as u64) {
        return 1;
    }
    return 0;
}

export fn main() -> i32 {
    return test_c8();
}
