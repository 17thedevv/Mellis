import <box>;
import <vec>;
import <string>;
import <hashmap>;
import <hashset>;
import <iter_collect>;

fn main() -> i32 {
    dec root_box: Box<i32> = std::box_new<i32>(7);
    dec std_box: std::Box<i32> = std::box_new<i32>(8);

    dec root_vec: Vec<i32> = vec_new<i32>();

    dec root_string: String = string_new();
    dec std_string: std::String = std::string_new();

    dec root_map: HashMap<i32, i32> = hashmap_new<i32, i32>();
    dec std_map: std::HashMap<i32, i32> = std::hashmap_new<i32, i32>();

    dec root_set: HashSet<i32> = hashset_new<i32>();
    dec std_set: std::HashSet<i32> = std::hashset_new<i32>();

    if *root_box.as_ref() != 7 || *std_box.as_ref() != 8 {
        return 1;
    }
    if root_vec.len() != (0 as u64) {
        return 2;
    }
    if root_string.len() != (0 as u64) || std_string.len() != (0 as u64) {
        return 3;
    }
    if root_map.len() != (0 as u64) || std_map.len() != (0 as u64) {
        return 4;
    }
    if root_set.len() != (0 as u64) || std_set.len() != (0 as u64) {
        return 5;
    }
    return 0;
}
