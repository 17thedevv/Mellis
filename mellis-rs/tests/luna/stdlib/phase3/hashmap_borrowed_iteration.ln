import <hashmap>;

fn main() -> i32 {
    dec rw map = hashmap_new<u64, u64>();
    map.insert(1 as u64, 10 as u64);
    map.insert(2 as u64, 20 as u64);
    map.insert(3 as u64, 30 as u64);
    dec rw count = 0 as u64;
    dec rw sum = 0 as u64;
    dec rw iter = map.iter();
    dec rw running = true;
    while running {
        match iter.next() {
            Option::Some(entry) -> {
                count = count + (1 as u64);
                sum = sum + *entry.0 + *entry.1;
            },
            Option::None -> { running = false; },
        }
    }
    if count != (3 as u64) || sum != (66 as u64) {
        return 1;
    }
    return 0;
}
