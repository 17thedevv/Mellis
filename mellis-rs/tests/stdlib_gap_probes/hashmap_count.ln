import <hashmap>;

fn main() -> i32 {
    // Attempting primitive key counting with HashMap<i32, i32>
    dec rw map = hashmap_new<i32, i32>();
    map.insert(10, 1);
    dec opt = map.get(&10);
    match opt {
        Option::Some(count) -> {
            if *count == 1 {
                return 0;
            }
            return 1;
        },
        Option::None -> {
            return 2;
        },
    }
}
