import <string>;
import <vec>;
import <hashmap>;

fn main() -> i32 {
    dec config_text = string_from_str("host=localhost\nport=8080\ndebug=true\nworkers=4\n");
    dec lines = config_text.lines();
    if lines.len() != (4 as u64) {
        return 1;
    }

    dec rw map = hashmap_new<String, String>();
    dec rw i: u64 = 0 as u64;
    while i < lines.len() {
        dec line_opt = lines.get(i);
        match line_opt {
            Option::Some(line) -> {
                dec parts = line.split('=');
                if parts.len() == (2 as u64) {
                    dec k = parts.get(0 as u64);
                    dec v = parts.get(1 as u64);
                    match k {
                        Option::Some(key_str) -> {
                            match v {
                                Option::Some(val_str) -> {
                                    dec clean_k = key_str.trim_string();
                                    dec clean_v = val_str.trim_string();
                                    map.insert(clean_k, clean_v);
                                },
                                Option::None -> {},
                            };
                        },
                        Option::None -> {},
                    };
                }
            },
            Option::None -> {},
        };
        i = i + (1 as u64);
    }

    // Verify parsed values in map
    dec host_key = string_from_str("host");
    match map.get(&host_key) {
        Option::Some(h) -> {
            if h.eq_str("localhost") == false { return 2; }
        },
        Option::None -> { return 3; },
    };

    dec port_key = string_from_str("port");
    match map.get(&port_key) {
        Option::Some(p) -> {
            match p.parse_i32() {
                Option::Some(port_num) -> {
                    if port_num != 8080 { return 4; }
                },
                Option::None -> { return 5; },
            };
        },
        Option::None -> { return 6; },
    };

    dec debug_key = string_from_str("debug");
    match map.get(&debug_key) {
        Option::Some(d) -> {
            match d.parse_bool() {
                Option::Some(flag) -> {
                    if flag == false { return 7; }
                },
                Option::None -> { return 8; },
            };
        },
        Option::None -> { return 9; },
    };

    dec workers_key = string_from_str("workers");
    match map.get(&workers_key) {
        Option::Some(w) -> {
            match w.parse_i32() {
                Option::Some(num) -> {
                    if num != 4 { return 10; }
                },
                Option::None -> { return 11; },
            };
        },
        Option::None -> { return 12; },
    };

    return 0;
}

