// probe_hashmap_entry_feasibility.ln
// Phase 4A Probe 1: HashMap Entry API Feasibility
//
// Tier ENTRY-A: Demonstrates that Rust-style Entry enum carrying mutable borrows
// through pattern matching and by-value consumption triggers E3005 LocalBorrowEscape
// because Luna lacks struct lifetime generic parameters.
//
// Tier ENTRY-B: Demonstrates that direct `get_or_insert(map, key, default) -> &rw V life_from(map)`
// is soundly supported in pure Luna.

import <hashmap>;

extern fn __luna_panic_default() -> !;

// =========================================================================
// Tier ENTRY-B: Direct get_or_insert (Canonical Sound Luna API)
// =========================================================================
export fn get_or_insert<K: Hash + Eq, V>(map: &rw HashMap<K, V>, key: K, default_val: V) -> &rw V life_from(map) {
    if map.contains_key(&key) == false {
        map.insert(key, default_val);
    }
    dec opt = map.get_mut(&key);
    match opt {
        Option::Some(v) -> {
            return v;
        },
        Option::None -> {
            __luna_panic_default();
        },
    }
}

fn main() -> i32 {
    dec rw map = hashmap_new<i32, i32>();
    dec v = get_or_insert<i32, i32>(&rw map, 10, 100);
    *v = 200;
    dec opt = map.get(&10);
    match opt {
        Option::Some(val) -> {
            if *val == 200 {
                return 0;
            }
            return 1;
        },
        Option::None -> {
            return 2;
        },
    }
}
