// Conversion Coherence Probe
// Verifies trait coherence rules regarding generic reflexive blanket impls vs concrete impls.
// CONVERT-COHERENCE-1: Generic blanket impl alone -> ACCEPTED
// CONVERT-COHERENCE-2: Non-overlapping concrete impl -> ACCEPTED
// CONVERT-COHERENCE-3: Concrete impl overlapping reflexive blanket impl -> REJECTED_AS_EXPECTED
// CONVERT-COHERENCE-4: Deterministic method dispatch

trait Convert<T> {
    fn convert(self: Self) -> T;
}

struct MyType {
    val: i32,
}

// Concrete non-overlapping impl (bool -> i32)
impl Convert<i32> for bool {
    fn convert(self: Self) -> i32 {
        if self {
            return 1;
        }
        return 0;
    }
}

// Blanket reflexive impl
impl<T> Convert<T> for T {
    fn convert(self: Self) -> T {
        return self;
    }
}

fn main() -> i32 {
    dec b: bool = true;
    dec v: i32 = b.convert();
    if v != 1 {
        return 1;
    }
    dec m = MyType { val: 42 };
    dec m2 = m.convert();
    if m2.val != 42 {
        return 2;
    }
    return 0;
}
